# =============================================================================
# Test/user_physics.math — User Extension Hooked via In-Memory `user_loader.h`
# =============================================================================
# Written entirely in modern MEP syntax:
#   - Unquoted function & constant declarations (`tau_const = 2π`, `rocket_dv(isp_s, m0_kg, mf_kg) = ...`)
#   - Omitted default `:real` parameter annotations & omitted default `-> real` return types
#   - Default parameter values (`fee_pct = 1.5`, `z = 0`, `base = 10`)
#   - Multi-line `{ ... }` blocks with default newline `;` statement separation
#   - Multi-branch `if ... or ... else`, pattern-matched `switch`, and tagged scopes `Tag : { ... }`
#   - Keywordless `(x in v) { ... }` / `(i in 1...n) { ... }` iteration

[user_physics]
<[boot_syntax]
<[boot_types]
<[boot_control]
<[arith]
<[trig]
<[geom_ext]
<[vec]
<[mat]
<[string]
<[algebra]
<[units]
<[physics]
<[chemistry]

# 1. Applied Aerospace & Fluid Engineering Functions
rocket_dv(isp_s, m0_kg, mf_kg) = isp_s * g0 * ln(m0_kg / mf_kg)

fspl_ratio(dist_m, lambda_m) = ((4π * dist_m) / lambda_m) ^ 2

# 2. Multi-Branch `if ... or ... else` & `switch` Demonstrations
classify_mach(m) -> str = {
    if (m < 0.8) {
        "subsonic"
    } or (m < 1.2) {
        "transonic"
    } or (m < 5.0) {
        "supersonic"
    } else {
        "hypersonic"
    }
}

planet_g(id) = switch (id) {
    case 1 : { 3.7 }
    case 2 : { 8.87 }
    case 3 : { 9.80665 }
    case 4 : { 3.721 }
    else   : { 0 }
}

# 3. Tagged Scopes (`Tag : { ... }`) with `jump(Tag)` & Inline Reuse (`run(Tag)` / `Tag()`)
collatz_steps(n) = {
    steps := 0
    jump(Loop)
    Tick : { steps += 1 }
    Loop : {
        if (n <= 1) {
            jump(Finish)
        } or ((n % 2) == 0) {
            n /= 2
            run(Tick)
            jump(Loop)
        } else {
            n = 3n + 1
            Tick()
            jump(Loop)
        }
    }
    Finish : { steps }
}

# 4. Host-Backed Realtime Currency Conversion (`@fx_rate`, `@fx_set_rate`)
fx_rate(from:str, to:str)      = @fx_rate(from, to)
fx_set_rate(ccy:str, per_usd)  = @fx_set_rate(ccy, per_usd)

convert_fx(amount, from:str, to:str) = {
    assert(amount >= 0, "Currency amount cannot be negative")
    amount * @fx_rate(from, to)
}

fx_with_fee(amount, from:str, to:str, fee_pct = 1.5) = {
    assert(amount >= 0, "Currency amount cannot be negative")
    assert(fee_pct >= 0 && fee_pct < 100, "Fee percentage must be in [0, 100)")
    gross := amount * @fx_rate(from, to)
    gross * (1 - fee_pct / 100)
}

(usd) to_inr :90 = usd * @fx_rate("USD", "INR")
(eur) to_usd :90 = eur * @fx_rate("EUR", "USD")

vec_sum_fx(prices_usd:vec, target_ccy:str) =
    prices_usd.sum() * @fx_rate("USD", target_ccy)

# 5. Host-Backed Vector-Returning Time Series (`@fx_history` -> `$vec`)
fx_history(from:str, to:str, days) -> vec = @fx_history(from, to, days)

fx_sma(from:str, to:str, days, window) =
    sma(@fx_history(from, to, days), window)

# 6. Host-Backed Persistent Key-Value Store (`@kv_set`, `@kv_get`)
save_var(key:str, val) = @kv_set(key, val)
load_var(key:str)      = @kv_get(key)

# 7. Host-Backed Periodic Table Atomic Mass Lookup (`@elem_mass`)
elem(sym:str)        = @elem_mass(sym)
molar_mass_h2o()     = 2 * @elem_mass("H")  + @elem_mass("O")
molar_mass_co2()     = @elem_mass("C")      + 2 * @elem_mass("O")
molar_mass_nacl()    = @elem_mass("Na")     + @elem_mass("Cl")
molar_mass_glucose() = 6 * @elem_mass("C")  + 12 * @elem_mass("H") + 6 * @elem_mass("O")

# 8. Unit-Typed Operators & Functions + Generic Unit `T`
(x:real, length) "+" (y:real, length) :<50 -> real, length = @add(x, y)
(x:real, length) "-" (y:real, length) :<50 -> real, length = @sub(x, y)

(d:real, length) "/" (t:real, time) :<60 -> real, speed    = @div(d, t)
(v:real, speed)    "*" (t:real, time) :<60 -> real, length = @mul(v, t)

avg_speed(d:real, length, t:real, time) -> real, speed = d / t

scale_unit(x:real, T, k)      -> real, T = x * k
unit_span(a:real, T, b:real, T) -> real, T = @abs(a - b)

# 9. User-Defined Custom Unit Type Groups (`data_size` & `bandwidth`)
(x) B  :95 -> real, data_size = x
(x) KB :95 -> real, data_size = x * 1024
(x) MB :95 -> real, data_size = x * (1024 ^ 2)
(x) GB :95 -> real, data_size = x * (1024 ^ 3)

(sz:real, data_size) "/" (t:real, time) :<60 -> real, bandwidth = @div(sz, t)
(bw:real, bandwidth) "*" (t:real, time) :<60 -> real, data_size = @mul(bw, t)

# 10. Streamlined Shorthand Functions, Default Params & Keywordless Loops
tau_const = 2π
hyp_3d(x, y, z = 0)    = √(x^2 + y^2 + z^2)
log_base(x, base = 10) = ln(x) / ln(base)

sum_squares_to(n) = {
    s := 0
    (i in 1...n) { s += i^2 }
    s
}

vec_dot_self(v:vec) = {
    s := 0
    (x in v) { s += x^2 }
    s
}

# 11. Semicolon-Free Multi-Line Bodies, Early `return`, `continue`,
#     Value-Returning `break`, Lambdas, Comprehensions & Pattern-Matched `switch`
safe_sqrt_ret(x) = {
    if (x < 0) { return -1 }
    if (x == 0) { return 0 }
    res := √x
    return res * 10
}

describe_vec2(p:vec2) -> str = switch (p) {
    case vec2(0, 0)           : { "origin" }
    case vec2(0, y)           : { "y-axis" }
    case vec2(x, 0)           : { "x-axis" }
    case vec2(x, y) if x == y : { "diagonal" }
    else                      : { "general" }
}

grade_band(score) -> str = switch (score) {
    case < 0, > 100 : { "invalid" }
    case >= 90      : { "A" }
    case 80...89    : { "B" }
    case 70...79    : { "C" }
    else            : { "F" }
}
