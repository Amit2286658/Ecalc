# =============================================================================
# Library/biology.math — High School & Quantitative Biology Numerical Suite
# =============================================================================

[biology]
<[arith]
<[trig]
<[vec]
<[chemistry]

# 1. Population Genetics (Hardy-Weinberg Equilibrium `p + q = 1`, `p^2 + 2pq + q^2 = 1`)
hw_q_from_p(p_dom)         = 1 - p_dom
hw_p_from_q2(q2_rec_freq)  = 1 - √q2_rec_freq
hw_homo_dom(p_dom)         = p_dom ^ 2
hw_hetero(p_dom)           = 2 * p_dom * (1 - p_dom)
hw_homo_rec(p_dom)         = (1 - p_dom) ^ 2
hw_carrier_count(q2_rec_freq, pop_size) = {
    q_val := √q2_rec_freq
    p_val := 1 - q_val
    2 * p_val * q_val * pop_size
}
recomb_freq(recombinants, total_offspring) = (recombinants / total_offspring) * 100
chi_sq_term(observed, expected)            = ((observed - expected) ^ 2) / expected

# 2. Molecular Biology & Biotechnology (Chargaff Rules, DNA Helix, Translation & PCR)
chargaff_g_from_a(a_pct)          = 50 - a_pct
chargaff_c_from_t(t_pct)          = 50 - t_pct
dna_length_nm(base_pairs)         = base_pairs * 0.34
dna_turns(base_pairs)             = base_pairs / 10
dna_weight_da(base_pairs)         = base_pairs * 650
codons_for_protein(amino_acids)   = amino_acids + 1
mrna_bases_for_protein(amino_acids) = 3 * (amino_acids + 1)
pcr_copies(n_cycles)              = 2 ^ n_cycles
pcr_yield_from(n0_templates, n_cycles) = n0_templates * (2 ^ n_cycles)
res_digest_linear(cut_sites)      = cut_sites + 1
res_digest_circular(cut_sites)    = cut_sites

# 3. Biochemistry, Enzyme Kinetics (Michaelis-Menten) & Bioenergetics
michaelis_menten(vmax, km, substrate_s) =
    (vmax * substrate_s) / (km + substrate_s)
competitive_inh_v(vmax, km, substrate_s, inh_i, ki) =
    (vmax * substrate_s) / (km * (1 + inh_i / ki) + substrate_s)
noncomp_inh_v(vmax, km, substrate_s, inh_i, ki) =
    ((vmax / (1 + inh_i / ki)) * substrate_s) / (km + substrate_s)
enzyme_catalytic_eff(kcat, km) = kcat / km

q10_rate(r1, t1_c, t2_c, q10_coeff = 2) =
    r1 * (q10_coeff ^ ((t2_c - t1_c) / 10))
q10_from_rates(r1, r2, t1_c, t2_c) =
    (r2 / r1) ^ (10 / (t2_c - t1_c))
respiratory_quotient(co2_produced, o2_consumed) = co2_produced / o2_consumed
aerobic_atp_yield(glucose_moles)                = 38 * glucose_moles

# 4. Plant Physiology & Water Potential (`Psi_w = Psi_s + Psi_p`, `DPD = OP - TP`)
water_potential(psi_s, psi_p)                  = psi_s + psi_p
solute_potential(i_ion, molarity_c, temp_k)    = -i_ion * molarity_c * 0.0831 * temp_k
diffusion_pressure_deficit(osmotic_p, turgor_p)= osmotic_p - turgor_p
stomatal_index(stomata_s, epidermal_e)         = (stomata_s / (stomata_s + epidermal_e)) * 100

# 5. Cell Biology, Microscopy & Morphometrics
total_magnification(ocular_mag, objective_mag)    = ocular_mag * objective_mag
actual_specimen_size(image_size, magnification)   = image_size / magnification
fov_diameter(fov_low, mag_low, mag_high)          = (fov_low * mag_low) / mag_high
mitotic_index(dividing_cells, total_cells)        = (dividing_cells / total_cells) * 100
cell_surface_sphere(r) = 4π * (r ^ 2)
cell_volume_sphere(r)  = (4 / 3) * π * (r ^ 3)
sa_to_vol_sphere(r)    = 3 / r

# 6. Human Physiology (Cardiovascular, Respiratory, Renal & Biometrics)
stroke_volume(edv_ml, esv_ml)               = edv_ml - esv_ml
ejection_fraction(edv_ml, esv_ml)           = ((edv_ml - esv_ml) / edv_ml) * 100
cardiac_output(hr_bpm, stroke_vol_ml)       = (hr_bpm * stroke_vol_ml) / 1000
pulse_pressure(systolic_p, diastolic_p)     = systolic_p - diastolic_p
mean_arterial_pressure(systolic_p, diastolic_p) = diastolic_p + (systolic_p - diastolic_p) / 3

minute_ventilation(tidal_vol_ml, resp_rate_bpm) = tidal_vol_ml * resp_rate_bpm
alveolar_ventilation(tidal_vol_ml, dead_space_ml, resp_rate_bpm) =
    (tidal_vol_ml - dead_space_ml) * resp_rate_bpm
vital_capacity(tv_ml, irv_ml, erv_ml)       = tv_ml + irv_ml + erv_ml
total_lung_capacity(vc_ml, rv_ml)           = vc_ml + rv_ml

net_filtration_pressure(ghp, bcops, chp)    = ghp - (bcops + chp)
renal_clearance(urine_conc_u, urine_flow_v, plasma_conc_p) =
    (urine_conc_u * urine_flow_v) / plasma_conc_p
bmi_calc(mass_kg, height_m)                 = mass_kg / (height_m ^ 2)

# 7. Ecology, Population Growth, Mark-Recapture & Biodiversity Indices
pop_exp_growth(n0, r_intrinsic, time_t)      = n0 * exp(r_intrinsic * time_t)
pop_doubling_time(r_intrinsic)               = ln(2) / r_intrinsic
pop_logistic_dNdt(r_intrinsic, n_cur, k_carrying) =
    r_intrinsic * n_cur * ((k_carrying - n_cur) / k_carrying)
pop_logistic_nt(n0, k_carrying, r_intrinsic, time_t) =
    k_carrying / (1 + ((k_carrying - n0) / n0) * exp(-r_intrinsic * time_t))
lincoln_petersen_pop(marked_m1, total_catch_c, recaptured_m2) =
    (marked_m1 * total_catch_c) / recaptured_m2
trophic_energy_at(base_energy, trophic_steps) = base_energy * (0.1 ^ trophic_steps)
net_primary_prod(gpp, respiration_r)          = gpp - respiration_r

# Simpson Index of Diversity `1 - sum(n_i*(n_i-1)) / (N*(N-1))`
simpson_diversity_vec(counts:vec) = {
    tot   := counts.sum()
    numer := 0
    (ni in counts) {
        numer += ni * (ni - 1)
    }
    1 - (numer / (tot * (tot - 1)))
}

# Shannon-Wiener Diversity Index `H = -sum((n_i/N) * ln(n_i/N))`
shannon_diversity_vec(counts:vec) = {
    tot := counts.sum()
    h   := 0
    (ni in counts) {
        if (ni > 0) {
            p_i := ni / tot
            h   -= p_i * ln(p_i)
        }
    }
    h
}
