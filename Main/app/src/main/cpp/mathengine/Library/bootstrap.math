# =============================================================================
# Library/bootstrap.math — Minimal Bootstrap Subset Hooked First by the C Core
# =============================================================================
# Defines syntax delimiters, consuming types (including scientific notation &
# digit separators in `$real`), generic entity/unit wildcards (`$T`, `$any`,
# `$none`), assignment/control operators, symbolic AST constructs, first-class
# function invocation, introspection, and `_` / `error`.
# Entity-specific operations for `$vec`, `$mat`, `$str`, and calculus live in
# their own modular files (`Library/vec.math`, `Library/mat.math`,
# `Library/string.math`, `Library/calculus.math`).

[boot_syntax]

# 1. Expression Grouping, Local Scope Braces, Matrix Brackets & Argument Delimiters
"(" => @lparen
")" => @rparen
"{" => @lbrace
"}" => @rbrace
"[" => @lbrack
"]" => @rbrack
"," => @comma


[boot_types]
<[boot_syntax]

# 2. Consuming Lexical Types, Scalar Imaginary Type ($iota), Dynamic Vector ($vec),
#    Multidimensional Matrix ($mat), First-Class Lambda Closure ($fn), Dictionary ($map)
#    & Polymorphic Type/Unit Wildcards ($T, $any, $none)
$real ~ ("0" [xX] [0123456789abcdefABCDEF]+ ("_" [0123456789abcdefABCDEF]+)* | "0" [bB] [01]+ ("_" [01]+)* | "." \d+ ("_" \d+)* ([eE] [+-]? \d+ ("_" \d+)*)? | \d+ ("_" \d+)* ("." \d+ ("_" \d+)*)? ([eE] [+-]? \d+ ("_" \d+)*)?) => @f64
$iota ~                      => @f64_trim1
$str  ~ "\"" [^"]* "\""      => @str_slice
$vec  ~                      => @vec_type
$mat  ~                      => @mat_type
$fn   ~                      => @fn_type
$map  ~                      => @map_type
$T    ~                      => @any_type
$any  ~                      => @any_type
$none ~                      => @none_unit


[boot_control]
<[boot_syntax]
<[boot_types]

# 3. Struct Member Access & UFCS Method Chaining Operator `.` (Left-associative, prec 95)
(s) "." (f) :<95 = @field(s, f)

# 4. Multi-Instruction Sequencing `;` (Left-associative infix, precedence 1)
#    Newline `\n` also acts as a default `;` separator for one-statement-per-line writing,
#    while `;` remains compulsory when placing multiple statements on a single line.
(a) ";" (b) :<1 = @seq(a, b)

# 5. Local Variable, Multi-Variable (`x, y := 5`), Destructuring (`r1, r2 := quad_roots(...)`)
#    & Compound Assignment Operators (`:=`, `=`, `+=`, `-=`, `*=`, `/=`, `%=`, `^=`, prec 5)
(target) ":=" (val) :>5 = @store(target, val, 1)
(target) "="  (val) :>5 = @store(target, val)
(target) "+=" (val) :>5 = @store(target, @add(target, val))
(target) "-=" (val) :>5 = @store(target, @sub(target, val))
(target) "*=" (val) :>5 = @store(target, @mul(target, val))
(target) "/=" (val) :>5 = @store(target, @div(target, val))
(target) "%=" (val) :>5 = @store(target, @mod(target, val))
(target) "^=" (val) :>5 = @store(target, @pow(target, val))

# 6. First-Class Lambda Arrow `=>` (Right-associative, prec 8), Pipe `|>` (Left-associative, prec 12) & `call`
(params) "=>" (body) :>8  -> fn = @lambda(params, body)
(x:T)    "|>" (f:T)  :<12 -> T  = @pipe(x, f)
call(f:fn)                      = @fcall(f, 0, 0)
call(f:fn, a:T)           -> T  = @fcall(f, a, 0)
call(f:fn, a:T, b:T)      -> T  = @fcall(f, a, b)
call(f:fn, a:T, b:T, c:T) -> T  = @fcall(f, a, b)
call(f:fn, a:T, b:T, c:T, d:T) -> T = @fcall(f, a, b)

# 7. Lazy While & Do-While Loop Operators `??` & `?!?` (Left-associative infix, precedence 3)
#    - Pre-tested while   : `(cond) ?? { body }`
#    - Post-tested do-while: `{ body } ?? (cond)` or `(body) ?!? (cond)`
(cond) "??"  (body) :<3 = @while(cond, body)
(body) "?!?" (cond) :<3 = @do_while(body, cond)

# 8. Standard Right-Associative Ternary Operator `cond ? x : y` (precedence 10)
(cond) "?" (branches) :>10 = @ternary(cond, branches)
(a)    ":" (b)        :>10 = @colon(a, b)

# 9. Strict Boolean-Condition Prefix NOT `!` (prec 80) & Distributed Combinators `&` and `|`
"!" (a:real, none) :80  = @cnot(a)
(a) "&" (b)        :<35 = @cand(a, b)
(a) "|" (b)        :<34 = @cor(a, b)

# 10. Multi-Branch `if ... or ... else`, `switch ... case ... else`, `for`/`in`, `jump`, `run`,
#     `break`, `continue` & `return`
if(cond, then_val, else_val) = @if(cond, then_val, else_val)
or(cond, body)               = @or_branch(cond, body)
then(cond, body)             = @or_branch(cond, body)
else(body)                   = @else_branch(body)
default(body)                = @else_branch(body)
switch(val, body)            = @switch_block(val, body)
case(val, body)              = @case_branch(val, body)
for(expr, body)              = @for_kw(expr, body)
(k:T) in (m:map)        :<42 = @map_has(m, k)
jump(tag)                    = @jump_tag(tag)
run(tag)                     = @run_tag(tag)
break()                      = @break_loop(0)
break(tag)                   = @break_loop(tag)
break(tag, val:T)       -> T = @break_loop(tag, val)
continue()                   = @continue_loop(0)
continue(tag)                = @continue_loop(tag)
return()                     = @return_fn(0)
return(val:T)           -> T = @return_fn(val)

# 11. Symbolic Expression Differentiation, Integration, Equation Solving, Simplification & Evaluation
sym_diff(var_x, expr)              -> str = @sym_diff(var_x, expr)
sym_diff(var_x, expr, order)       -> str = @sym_diff(var_x, expr, order)
sym_diff_n(var_x, expr, order)     -> str = @sym_diff(var_x, expr, order)
sym_integ(var_x, expr)             -> str = @sym_integ(var_x, expr)
sym_solve(var_x, eq)               -> str = @sym_solve(var_x, eq)
sym_simplify(expr:T)               -> str = @sym_simplify(expr)
simplify(expr:T)                   -> str = @sym_simplify(expr)
sym_eval(expr_str:str, var_x, val)        = @sym_eval(expr_str, var_x, val)

# 12. Runtime Entity/Unit Introspection, Unit Transfer (`raw_val`, `with_unit`),
#     Scratch Arena Compaction & Plain String Conversion Operators `_`
raw_val(x)           -> real, none = @raw(x)
with_unit(val, donor)              = @raw(val, donor)
with_unit(val:str, donor:T) -> str = val
type_of(x:T)         -> str        = @type_name(x)
elem_type_of(x:T)    -> str        = @type_name(x, 1)
type_sig_of(x:T)     -> str        = @type_name(x, 2)
unit_of(x:T)         -> str        = @unit_name(x)
unit_dim(x:T, axis)                = @unit_name(x, axis)
gc_compact()                       = @gc_compact(0)
pool_used()                        = @pool_used(0)
(x:T) "_"   :95      -> str        = @tostr(x)
"_" (s:str) :85      -> T          = @fromstr(s)

# 13. Custom Runtime Error & Assertion Functions (`error("...")`, `assert(cond, "...")`)
error(msg:str)        = @err(msg)
assert(cond, msg:str) = if(cond, 1, error(msg))
