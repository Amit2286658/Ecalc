# =============================================================================
# Library/mat.math — Multidimensional Matrices & Tensors (`$mat`)
# =============================================================================
# Dedicated module for 1D-4D dense matrices/tensors (`[a, b ; c, d]`),
# pure MEP matrix arithmetic (`+`, `-`, `*`, scalar `*`/`/`, `transpose`),
# Hadamard elementwise operators (`.*`, `./`, `.^`), linear system solver
# (`linsolve`), inverse (`inv`), determinant (`det`), trace, constructors,
# decompositions (LU, QR, Cholesky, Eigen, SVD), and higher-order tensor pipelines.

[mat]
<[boot_types]
<[boot_control]
<[arith]
<[vec]

# 1. Shape Queries, Reshaping & Higher-Order Functional Pipelines on `$mat`
# @desc Computes `mat_rank(m: mat)` in module [mat] (Shape Queries, Reshaping & Higher-Order Functional Pipelines on `$mat`). Formula: mat_rank(m:mat) = @mrank(m)
# @param m: mat — Input matrix or map dictionary
# @return any — Result returned by `mat_rank(m: mat)` in [mat]
mat_rank(m:mat)                      = @mrank(m)
# @desc Returns the total number of scalar cells (rows × cols) in matrix m. Formula: mat_len(m) = @mlen(m)
# @param m: mat — Input matrix
# @return int — Total element count in `m`
mat_len(m:mat)                       = @mlen(m)
# @desc Computes `mat_dim(m: mat, axis: real)` in module [mat] (Shape Queries, Reshaping & Higher-Order Functional Pipelines on `$mat`). Formula: mat_dim(m:mat, axis) = @mdim(m, axis)
# @param m: mat — Input matrix or map dictionary
# @param axis: real — Input parameter `axis` for `mat_dim`
# @return any — Result returned by `mat_dim(m: mat, axis: real)` in [mat]
mat_dim(m:mat, axis)                 = @mdim(m, axis)
# @desc Returns the number of rows in matrix m. Formula: mat_rows(m) = @mdim(m, 0)
# @param m: mat — Input matrix
# @return int — Row count of `m`
mat_rows(m:mat)                      = @mdim(m, 0)
# @desc Returns the number of columns in matrix m. Formula: mat_cols(m) = @mdim(m, 1)
# @param m: mat — Input matrix
# @return int — Column count of `m`
mat_cols(m:mat)                      = (mat_rank(m) >= 2) ? @mdim(m, 1) : @mdim(m, 0)
# @desc Returns the dimension vector `[rows, cols]` of matrix m. Formula: mat_shape(m)
# @param m: mat — Input matrix
# @return vec — Shape vector `[rows, cols]`
mat_shape(m:mat)          -> vec     = [@mdim(m, i) for i in 0..<mat_rank(m)]
# @desc Reshapes a matrix or vector into a new r×c matrix with the same total element count in row-major order. Formula: reshape(m, r, c) = @mreshape(m, r, c)
# @param m: mat | vec — Input matrix or vector with r × c elements
# @param r: int — Target row count
# @param c: int — Target column count
# @return mat — Reshaped r×c matrix
reshape(m:mat, r, c)      -> mat     = @mreshape(m, r, c)
reshape(v:vec, r, c)      -> mat     = @mreshape(v, r, c)
# @desc Flattens a 2D matrix into a 1D vector in row-major order. Formula: flatten(m) = [x for x in m]
# @param m: mat — Input r×c matrix
# @return vec — 1D vector containing all r × c elements of `m`
flatten(m:mat)            -> vec     = [x for x in m]
# @desc Constructs an r×c matrix with every cell initialized to value v. Formula: mat_fill(r, c, v)
# @param r: int — Number of rows
# @param c: int — Number of columns
# @param v: real — Fill value for all cells
# @return mat — r×c matrix filled with `v`
mat_fill(r, c, v:real, T) -> mat, T  = {
    if (r <= 0 || c <= 0) { error("Matrix dimensions must be positive") }
    vec(r * c, v).reshape(r, c)
}
# @desc Constructs an r×c matrix filled entirely with 0.0. Formula: mat_zeros(r, c) = mat_fill(r, c, 0)
# @param r: int — Number of rows
# @param c: int — Number of columns
# @return mat — r×c zero matrix
mat_zeros(r, c)           -> mat     = mat_fill(r, c, 0)
# @desc Constructs an r×c matrix filled entirely with 1.0. Formula: mat_ones(r, c) = mat_fill(r, c, 1)
# @param r: int — Number of rows
# @param c: int — Number of columns
# @return mat — r×c all-ones matrix
mat_ones(r, c)            -> mat     = mat_fill(r, c, 1)
# @desc Constructs the n×n identity matrix I_n with 1s on the main diagonal and 0s elsewhere. Formula: mat_eye(n)
# @param n: int — Positive matrix dimension (number of rows and columns)
# @return mat — n×n identity matrix I_n
mat_eye(n)                -> mat     = {
    if (n <= 0) { error("Identity matrix dimension must be positive") }
    out := mat_zeros(n, n)
    (i in 0..<n) { out[i, i] = 1 }
    out
}

# @desc Applies transformation function `f(x)` to every element of a vector or matrix, or constructs a key-value `$map` dictionary when called with key-value arguments. Formula: map(container, f)
# @param m: vec | mat — Input vector or matrix to transform
# @param f: fn — Element mapping function or lambda `x => ...`
# @return vec | mat | map — Transformed container of the same shape, or a new `$map` dictionary
map(m:mat, f:fn)          -> mat = @mreshape([f(x) for x in m], m, 0)
# @desc Selects all elements from a vector or matrix for which predicate function `f(x)` returns true (non-zero). Formula: filter(m, f) = [x for x in m if f(x)]
# @param m: vec | mat — Input vector or matrix
# @param f: fn — Boolean predicate lambda `x => ...`
# @return vec — Vector of elements satisfying `f(x) != 0`
filter(m:mat, f:fn)       -> vec = [x for x in m if f(x)]
# @desc Folds a vector or matrix down to a single value by repeatedly applying binary accumulator `f(acc, x)`. Formula: reduce(m, f)
# @param m: vec | mat — Non-empty input vector or matrix
# @param f: fn — Binary reduction lambda `(acc, x) => ...`
# @return any — Accumulated reduction result
reduce(m:mat, f:fn)              = reduce(flatten(m), f)
reduce(m:mat, init, f:fn)        = reduce(flatten(m), init, f)
# @desc Folds a vector or matrix from an explicit initial accumulator value `init` using binary function `f(acc, x)`. Formula: fold(m, init, f)
# @param m: vec | mat — Input vector or matrix
# @param init: any — Initial accumulator value
# @param f: fn — Binary reduction lambda `(acc, x) => ...`
# @return any — Final accumulated value
fold(m:mat, init, f:fn)          = reduce(flatten(m), init, f)
# @desc Returns 1 (true) if at least one element in a vector or matrix satisfies predicate `f(x)`, or 0 otherwise. Formula: any(m, f)
# @param m: vec | mat — Input vector or matrix
# @param f: fn — Boolean predicate lambda `x => ...`
# @return bool — 1 if any element satisfies `f(x)`, else 0
any(m:mat, f:fn)                 = any(flatten(m), f)
# @desc Returns 1 (true) if every element in a vector or matrix satisfies predicate `f(x)`, or 0 otherwise. Formula: all(m, f)
# @param m: vec | mat — Input vector or matrix
# @param f: fn — Boolean predicate lambda `x => ...`
# @return bool — 1 if all elements satisfy `f(x)`, else 0
all(m:mat, f:fn)                 = all(flatten(m), f)
# @desc Returns the first element in a vector or matrix that satisfies predicate `f(x)`, or `nan` if none matches. Formula: find(m, f)
# @param m: vec | mat — Input vector or matrix
# @param f: fn — Boolean predicate lambda `x => ...`
# @return any — First matching element, or `nan` if not found
find(m:mat, f:fn)                = find(flatten(m), f)
# @desc Counts the number of elements in a vector or matrix that satisfy predicate `f(x)`. Formula: count_if(m, f)
# @param m: vec | mat — Input vector or matrix
# @param f: fn — Boolean predicate lambda `x => ...`
# @return int — Count of elements for which `f(x)` is non-zero
count_if(m:mat, f:fn)            = count_if(flatten(m), f)
# @desc Returns a vector containing the first `k` elements of a vector or flattened matrix. Formula: take(m, k)
# @param m: vec | mat — Input vector or matrix
# @param k: int — Number of leading elements to take
# @return vec — Vector of the first `k` elements
take(m:mat, k)            -> vec = take(flatten(m), k)
# @desc Returns a vector with the first `k` elements of a vector or flattened matrix skipped. Formula: drop(m, k)
# @param m: vec | mat — Input vector or matrix
# @param k: int — Number of leading elements to skip
# @return vec — Vector of remaining elements after index `k - 1`
drop(m:mat, k)            -> vec = drop(flatten(m), k)
# @desc Sorts the elements of a vector or flattened matrix in ascending order of a key function `key_fn(x)`. Formula: sort_by(v, key_fn)
# @param v: vec | mat — Input vector or matrix
# @param key_fn: fn — Key projection lambda `x => ...` returning a comparable number
# @return vec — Vector of elements ordered by ascending `key_fn(x)`
sort_by(m:mat, key_fn:fn) -> vec = sort_by(flatten(m), key_fn)

# @desc Combines two same-shape matrices `a` and `b` cell-by-cell using binary function `f(a[i,j], b[i,j])`. Formula: mat_zip(a, b, f)
# @param a: mat — First r×c matrix
# @param b: mat — Second r×c matrix
# @param f: fn — Binary function `(x, y) => ...`
# @return mat — r×c matrix of element-wise results
mat_zip(a:mat, b:mat, f:fn) -> mat = {
    if (mat_shape(a) != mat_shape(b)) { error("Matrix shape mismatch") }
    va := [x for x in a]
    vb := [x for x in b]
    vr := [f(x, vb[i]) for i, x in va]
    @mreshape(vr, a, 0)
}

# 2. Pure MEP Matrix Arithmetic, Matrix Multiplication, Scaling & Membership Operators
"-" (m:mat, T)                 :80  -> mat, T = m.map(x => -x)
(a:mat, T)     "+"  (b:mat, T) :<50 -> mat, T = mat_zip(a, b, (x, y) => x + y)
(a:mat, T)     "-"  (b:mat, T) :<50 -> mat, T = mat_zip(a, b, (x, y) => x - y)
(a:mat, T)     into (b:mat, T) :>55 -> mat, T = mat_zip(a, b, (x, y) => x + y)

(a:mat) "*" (b:mat) :<60 -> mat = {
    ra := mat_rank(a)
    rb := mat_rank(b)
    if (ra == 2 && rb == 2) {
        M  := mat_rows(a)
        K  := mat_cols(a)
        Kb := mat_rows(b)
        N  := mat_cols(b)
        if (K != Kb) { error("Matrix dimension mismatch in '*'") }
        u0  := 0 * a[0, 0] * b[0, 0]
        out := mat_fill(M, N, u0)
        (r in 0..<M) {
            (col in 0..<N) {
                s := u0
                (k in 0..<K) { s += a[r, k] * b[k, col] }
                out[r, col] = s
            }
        }
        return out
    }
    if (ra == 2 && rb == 1) {
        M  := mat_rows(a)
        K  := mat_cols(a)
        Kb := mat_len(b)
        if (K != Kb) { error("Matrix-vector dimension mismatch in '*'") }
        u0 := 0 * a[0, 0] * b[0]
        vr := vec(M, u0)
        (r in 0..<M) {
            s := u0
            (k in 0..<K) { s += a[r, k] * b[k] }
            vr[r] = s
        }
        return @mreshape(vr, M, 0)
    }
    if (ra == 1 && rb == 1 && mat_len(a) == mat_len(b)) {
        n  := mat_len(a)
        vr := [a[i] * b[i] for i in 0..<n]
        return @mreshape(vr, n, 0)
    }
    error("Matrix multiplication '*' requires 2D*2D or 2D*1D compatible dimensions")
    mat_zeros(1, 1)
}

(m:mat) "*" (s:real) :<60 -> mat = m.map(x => x * s)
(s:real) "*" (m:mat) :<60 -> mat = m.map(x => s * x)
(m:mat) "/" (s:real) :<60 -> mat = {
    if (s == 0) { error("Division by zero in matrix scalar division") }
    m.map(x => x / s)
}

(item:real, T) in (m:mat, T) :<42 = {
    u_it := unit_of(item)
    (x in m) {
        if (@eq(unit_of(x), u_it)) {
            if (x == item) { return 1 }
        }
    }
    0
}

# 3. Elementwise (Hadamard) Matrix Operators (`.*`, `./`, `.^`)
(a:mat)  ".*" (b:mat)  :<60 -> mat = mat_zip(a, b, (x, y) => x * y)
(a:mat)  "./" (b:mat)  :<60 -> mat = mat_zip(a, b, (x, y) => x / y)
(a:mat)  ".^" (b:real) :>85 -> mat = a.map(x => x ^ b)
(a:real) ".^" (b:mat)  :>85 -> mat = b.map(x => a ^ x)
(a:mat)  ".^" (b:mat)  :>85 -> mat = mat_zip(a, b, (x, y) => x ^ y)

# 4. Pure MEP `transpose`, `trace`, `det`, `inv` & `linsolve`
# @desc Flips a matrix M over its main diagonal, turning an r×c matrix into a c×r matrix Mᵀ. Formula: transpose(m)
# @param m: mat | mat2 — Input r×c matrix or 2×2 `$mat2` struct
# @return mat | mat2 — Transposed c×r matrix Mᵀ
transpose(m:mat, T) -> mat, T = {
    r := mat_rank(m)
    if (r == 1) { return @mreshape(m, mat_len(m), 1) }
    if (r != 2) { error("transpose() requires a 2D matrix") }
    rows := mat_rows(m)
    cols := mat_cols(m)
    flat := vec(rows * cols)
    (j in 0..<cols) {
        (i in 0..<rows) {
            m[i, j] into flat
        }
    }
    @mreshape(flat, cols, rows)
}

# @desc Computes the matrix trace tr(M) = ∑ M[i, i], the sum of elements along the main diagonal. Formula: trace(m)
# @param m: mat | mat2 — Square matrix or `$mat2` struct
# @return real — Sum of diagonal elements tr(m)
trace(m:mat, T) -> real, T = {
    r := mat_rows(m)
    if (mat_rank(m) != 2 || r != mat_cols(m) || r == 0) { error("trace() requires a non-empty square 2D matrix") }
    s := 0 * m[0, 0]
    (i in 0..<r) { s += m[i, i] }
    s
}

# @desc Computes the scalar determinant det(M) of a square n×n matrix (via LU decomposition) or a 2×2 `$mat2` struct. Formula: det(m)
# @param m: mat | mat2 — Square n×n matrix or `$mat2` struct
# @return real — Scalar determinant det(m)
det(m:mat) = {
    n := mat_rows(m)
    if (mat_rank(m) != 2 || n != mat_cols(m) || n == 0) { error("det() requires a square 2D matrix") }
    A := m.map(x => raw_val(x))
    d := 1
    (i in 0..<n) {
        piv := i
        mx  := @abs(A[i, i])
        (r in (i + 1)..<n) {
            v := @abs(A[r, i])
            if (v > mx) { mx = v ; piv = r }
        }
        if (mx <= 1e-14) { return 0 }
        if (piv != i) {
            (col in i..<n) {
                t := A[i, col] ; A[i, col] = A[piv, col] ; A[piv, col] = t
            }
            d = -d
        }
        diag_v := A[i, i]
        d *= diag_v
        (r in (i + 1)..<n) {
            f := A[r, i] / diag_v
            (col in (i + 1)..<n) {
                A[r, col] = A[r, col] - f * A[i, col]
            }
        }
    }
    (@abs(d) < 1e-14) ? 0 : d
}

# @desc Computes the multiplicative inverse M⁻¹ of a non-singular square n×n matrix or `$mat2` struct such that M · M⁻¹ = I. Formula: inv(m)
# @param m: mat | mat2 — Invertible square matrix (det(m) ≠ 0)
# @return mat | mat2 — Inverse matrix M⁻¹
inv(m:mat) -> mat = {
    n := mat_rows(m)
    if (mat_rank(m) != 2 || n != mat_cols(m) || n == 0) { error("inv() requires a square 2D matrix") }
    A := m.map(x => raw_val(x))
    B := mat_eye(n)
    (i in 0..<n) {
        piv := i
        mx  := @abs(A[i, i])
        (r in (i + 1)..<n) {
            v := @abs(A[r, i])
            if (v > mx) { mx = v ; piv = r }
        }
        if (mx <= 1e-14) { error("Singular matrix cannot be inverted (det == 0)") }
        if (piv != i) {
            (col in 0..<n) {
                ta := A[i, col] ; A[i, col] = A[piv, col] ; A[piv, col] = ta
                tb := B[i, col] ; B[i, col] = B[piv, col] ; B[piv, col] = tb
            }
        }
        diag_v := A[i, i]
        (col in 0..<n) {
            A[i, col] = A[i, col] / diag_v
            B[i, col] = B[i, col] / diag_v
        }
        (r in 0..<n) {
            if (r != i) {
                f := A[r, i]
                if (@abs(f) > 0) {
                    (col in 0..<n) {
                        A[r, col] = A[r, col] - f * A[i, col]
                        B[r, col] = B[r, col] - f * B[i, col]
                    }
                }
            }
        }
    }
    B.map(x => (@abs(x) < 1e-15) ? 0 : x)
}

# @desc Solves the square linear system A · x = b for vector x using Gaussian elimination with partial pivoting. Formula: linsolve(a, b)
# @param a: mat — Non-singular n×n coefficient matrix A
# @param b: vec — Right-hand side n-element vector b
# @return vec — Solution vector x of length n satisfying A · x = b
linsolve(a:mat, b:vec) -> vec = {
    n := mat_rows(a)
    if (mat_rank(a) != 2 || n != mat_cols(a) || n == 0) { error("linsolve(A, b) requires a square 2D matrix A") }
    if (b.len() != n) { error("linsolve(A, b) dimension mismatch") }
    u1  := with_unit(1, b[0] / a[0, 0])
    A   := a.map(x => raw_val(x))
    rhs := [raw_val(x) for x in b]
    (i in 0..<n) {
        piv := i
        mx  := @abs(A[i, i])
        (r in (i + 1)..<n) {
            v := @abs(A[r, i])
            if (v > mx) { mx = v ; piv = r }
        }
        if (mx <= 1e-14) { error("Singular matrix in linsolve(A, b) (det == 0)") }
        if (piv != i) {
            (col in i..<n) {
                ta := A[i, col] ; A[i, col] = A[piv, col] ; A[piv, col] = ta
            }
            tb := rhs[i] ; rhs[i] = rhs[piv] ; rhs[piv] = tb
        }
        diag_v := A[i, i]
        (col in i..<n) { A[i, col] = A[i, col] / diag_v }
        rhs[i] = rhs[i] / diag_v
        (r in 0..<n) {
            if (r != i) {
                f := A[r, i]
                if (@abs(f) > 0) {
                    (col in i..<n) { A[r, col] = A[r, col] - f * A[i, col] }
                    rhs[r] = rhs[r] - f * rhs[i]
                }
            }
        }
    }
    [((@abs(x) < 1e-15) ? 0 : x) * u1 for x in rhs]
}

linsolve(a:mat, b:mat) -> mat = {
    n  := mat_rows(a)
    rb := mat_rank(b)
    if (rb == 1) {
        if (mat_len(b) != n) { error("linsolve(A, b) dimension mismatch") }
        vr := linsolve(a, flatten(b))
        return @mreshape(vr, n, 0)
    }
    if (rb != 2 || mat_rows(b) != n) { error("linsolve(A, b) dimension mismatch") }
    k   := mat_cols(b)
    u0  := 0 * (b[0, 0] / a[0, 0])
    out := mat_fill(n, k, u0)
    (col in 0..<k) {
        cv  := [b[r, col] for r in 0..<n]
        sol := linsolve(a, cv)
        (r in 0..<n) { out[r, col] = sol[r] }
    }
    out
}


# 5. Diagonals, Reductions & Matrix Powers (`A ^ n`)

# @desc Extracts the main diagonal of a matrix as a vector, or constructs a diagonal matrix from a vector `v`. Formula: diag(v)
# @param v: vec | mat — Input vector (to build a diagonal matrix) or matrix (to extract its diagonal)
# @return mat | vec — Diagonal n×n matrix or extracted diagonal vector
diag(v:vec) -> mat = {
    n   := v.len()
    out := mat_zeros(n, n)
    (i, x in v) { out[i, i] = x }
    out
}

diag(m:mat, T) -> vec = {
    n := min(mat_rows(m), mat_cols(m))
    [m[i, i] for i in 0..<n]
}

# @desc Computes the sum of all scalar elements in matrix m. Formula: mat_sum(m)
# @param m: mat — Input matrix
# @return real — Total sum of all entries in `m`
mat_sum(m:mat, T)        -> real, T = m.reduce((a, b) => a + b)
# @desc Computes the arithmetic mean of all scalar elements in matrix m. Formula: mat_mean(m) = mat_sum(m) / mat_len(m)
# @param m: mat — Input matrix
# @return real — Mean of all entries in `m`
mat_mean(m:mat, T)       -> real, T = mat_sum(m) / mat_len(m)
# @desc Returns the smallest element in matrix m. Formula: mat_min(m)
# @param m: mat — Input matrix
# @return real — Minimum entry in `m`
mat_min(m:mat, T)        -> real, T = m.reduce((a, b) => a < b ? a : b)
# @desc Returns the largest element in matrix m. Formula: mat_max(m)
# @param m: mat — Input matrix
# @return real — Maximum entry in `m`
mat_max(m:mat, T)        -> real, T = m.reduce((a, b) => a > b ? a : b)
# @desc Computes the Frobenius norm ‖M‖_F = √(∑ |M_{i,j}|²) of matrix m. Formula: frobenius_norm(m) = √sum(m^2)
# @param m: mat — Input matrix
# @return real — Frobenius norm ‖M‖_F ≥ 0
frobenius_norm(m:mat, T) -> real, T = √(m.map(x => x^2).reduce((a, b) => a + b))

# @desc Raises a square matrix m to integer power n (n = 0 returns I, n < 0 computes inv(m)^|n|). Formula: mat_pow(m, n)
# @param m: mat — Square n×n matrix
# @param n: int — Integer exponent (positive, zero, or negative)
# @return mat — Matrix power M^n
mat_pow(m:mat, n:real, none) -> mat = {
    r := mat_rows(m)
    if (r != mat_cols(m)) { error("Matrix power requires a square matrix") }
    if (n != @floor(n)) { error("Matrix power exponent must be an integer") }
    acc  := mat_eye(r)
    base := (n < 0) ? inv(m) : m
    k    := @abs(n)
    (k > 0) ?? {
        if (k % 2 == 1) { acc = acc * base }
        base = base * base
        k    = @floor(k / 2)
    }
    acc
}

(m:mat) "^" (n:real, none) :>85 -> mat = mat_pow(m, n)


# 6. Matrix-Vector Products (`M * v`, `v * M`), Outer/Kronecker Products, Concatenation & Triangular Parts
(m:mat) "*" (v:vec) :<60 -> vec = {
    if (mat_rank(m) != 2) { error("mat * vec requires a 2D matrix on the left") }
    M := mat_rows(m)
    K := mat_cols(m)
    if (K != v.len()) { error("mat * vec dimension mismatch") }
    u0  := 0 * m[0, 0] * v[0]
    out := vec(M, u0)
    (r in 0..<M) {
        s := u0
        (k in 0..<K) { s += m[r, k] * v[k] }
        out[r] = s
    }
    out
}

(v:vec) "*" (m:mat) :<60 -> vec = {
    if (mat_rank(m) != 2) { error("vec * mat requires a 2D matrix on the right") }
    M := mat_rows(m)
    N := mat_cols(m)
    if (v.len() != M) { error("vec * mat dimension mismatch") }
    u0  := 0 * v[0] * m[0, 0]
    out := vec(N, u0)
    (col in 0..<N) {
        s := u0
        (r in 0..<M) { s += v[r] * m[r, col] }
        out[col] = s
    }
    out
}

# @desc Computes the outer product matrix M[i, j] = a[i] · b[j] of two vectors `a` and `b`. Formula: outer(a, b)
# @param a: vec — Column vector of length m
# @param b: vec — Row vector of length n
# @return mat — m×n outer product matrix `a ⊗ b`
outer(a:vec, b:vec) -> mat = {
    na  := a.len()
    nb  := b.len()
    out := mat_zeros(na, nb)
    (i, x in a) {
        (j, y in b) { out[i, j] = x * y }
    }
    out
}

# @desc Stacks two matrices `a` and `b` with the same column count vertically on top of each other. Formula: vstack(a, b)
# @param a: mat — Top matrix (r₁ × c)
# @param b: mat — Bottom matrix (r₂ × c)
# @return mat — Vertically stacked (r₁ + r₂) × c matrix
vstack(a:mat, b:mat) -> mat = {
    ra := (mat_rank(a) == 1) ? 1 : mat_rows(a)
    ca := (mat_rank(a) == 1) ? mat_len(a) : mat_cols(a)
    rb := (mat_rank(b) == 1) ? 1 : mat_rows(b)
    cb := (mat_rank(b) == 1) ? mat_len(b) : mat_cols(b)
    if (ca != cb) { error("vstack() requires matching column counts") }
    fa  := flatten(a)
    fb  := flatten(b)
    out := mat_zeros(ra + rb, ca)
    (i in 0..<ra) { (j in 0..<ca) { out[i, j] = fa[i * ca + j] } }
    (i in 0..<rb) { (j in 0..<cb) { out[ra + i, j] = fb[i * cb + j] } }
    out
}

# @desc Concatenates two matrices `a` and `b` with the same row count horizontally side-by-side `[a | b]`. Formula: hstack(a, b)
# @param a: mat — Left matrix (r × c₁)
# @param b: mat — Right matrix (r × c₂)
# @return mat — Horizontally augmented r × (c₁ + c₂) matrix
hstack(a:mat, b:mat) -> mat = {
    ra := (mat_rank(a) == 1) ? 1 : mat_rows(a)
    ca := (mat_rank(a) == 1) ? mat_len(a) : mat_cols(a)
    rb := (mat_rank(b) == 1) ? 1 : mat_rows(b)
    cb := (mat_rank(b) == 1) ? mat_len(b) : mat_cols(b)
    if (ra != rb) { error("hstack() requires matching row counts") }
    fa  := flatten(a)
    fb  := flatten(b)
    out := mat_zeros(ra, ca + cb)
    (i in 0..<ra) {
        (j in 0..<ca) { out[i, j] = fa[i * ca + j] }
        (j in 0..<cb) { out[i, ca + j] = fb[i * cb + j] }
    }
    out
}

# @desc Computes the Kronecker tensor product A ⊗ B of two matrices `a` and `b`. Formula: kron(a, b)
# @param a: mat — First matrix (r₁ × c₁)
# @param b: mat — Second matrix (r₂ × c₂)
# @return mat — Block Kronecker product matrix of size (r₁·r₂) × (c₁·c₂)
kron(a:mat, b:mat)   -> mat = {
    ra  := mat_rows(a)
    ca  := mat_cols(a)
    rb  := mat_rows(b)
    cb  := mat_cols(b)
    out := mat_zeros(ra * rb, ca * cb)
    (ia in 0..<ra) {
        (ja in 0..<ca) {
            va := a[ia, ja]
            (ib in 0..<rb) {
                (jb in 0..<cb) {
                    out[ia * rb + ib, ja * cb + jb] = va * b[ib, jb]
                }
            }
        }
    }
    out
}

# @desc Extracts the lower-triangular part of matrix m on and below diagonal offset k (k = 0 is the main diagonal). Formula: tril(m, k = 0)
# @param m: mat — Input matrix
# @param k: int — Diagonal offset (0 = main diagonal, k > 0 above, k < 0 below; default 0)
# @return mat — Matrix with entries above the k-th diagonal zeroed out
tril(m:mat, k = 0) -> mat = {
    r   := mat_rows(m)
    c   := mat_cols(m)
    out := mat_zeros(r, c)
    (i in 0..<r) {
        (j in 0..<c) {
            if (j - i <= k) { out[i, j] = m[i, j] }
        }
    }
    out
}

# @desc Extracts the upper-triangular part of matrix m on and above diagonal offset k (k = 0 is the main diagonal). Formula: triu(m, k = 0)
# @param m: mat — Input matrix
# @param k: int — Diagonal offset (0 = main diagonal, k > 0 above, k < 0 below; default 0)
# @return mat — Matrix with entries below the k-th diagonal zeroed out
triu(m:mat, k = 0) -> mat = {
    r   := mat_rows(m)
    c   := mat_cols(m)
    out := mat_zeros(r, c)
    (i in 0..<r) {
        (j in 0..<c) {
            if (j - i >= k) { out[i, j] = m[i, j] }
        }
    }
    out
}

# 7. Matrix Decompositions (LU, QR, Cholesky, Eigenvalues/Vectors, SVD), Pseudoinverse, Least Squares & Norms
# @desc Computes `lu_helper(m: mat, mode: real)` in module [mat] (Matrix Decompositions (LU, QR, Cholesky, Eigenvalues/Vectors, SVD), Pseudoinverse, Least Squares & Norms).
# @param m: mat — Input matrix or map dictionary
# @param mode: real — Input parameter `mode` for `lu_helper`
# @return mat — Result returned by `lu_helper(m: mat, mode: real)` in [mat]
lu_helper(m:mat, mode) -> mat = {
    n := mat_rows(m)
    if (mat_rank(m) != 2 || n != mat_cols(m) || n == 0) { error("LU decomposition requires a non-empty square 2D matrix") }
    L := mat_eye(n)
    U := m.map(x => x)
    P := mat_eye(n)
    (k in 0..<n) {
        piv := k
        mx  := @abs(U[k, k])
        (i in (k + 1)..<n) {
            v := @abs(U[i, k])
            if (v > mx) { mx = v ; piv = i }
        }
        if (piv != k) {
            (j in 0..<n) {
                tu := U[k, j] ; U[k, j] = U[piv, j] ; U[piv, j] = tu
                tp := P[k, j] ; P[k, j] = P[piv, j] ; P[piv, j] = tp
            }
            (j in 0..<k) {
                tl := L[k, j] ; L[k, j] = L[piv, j] ; L[piv, j] = tl
            }
        }
        ukk := U[k, k]
        if (@abs(ukk) > 1e-15) {
            (i in (k + 1)..<n) {
                f := U[i, k] / ukk
                L[i, k] = f
                U[i, k] = 0
                (j in (k + 1)..<n) {
                    U[i, j] = U[i, j] - f * U[k, j]
                }
            }
        }
    }
    (mode == 0) ? L : ((mode == 1) ? U : P)
}

# @desc Computes the unit lower-triangular factor L in the PA = L · U decomposition with partial pivoting. Formula: lu_l(m)
# @param m: mat — Square n×n matrix
# @return mat — Unit lower-triangular matrix L
lu_l(m:mat)             -> mat = lu_helper(m, 0)
# @desc Computes the upper-triangular factor U in the PA = L · U decomposition with partial pivoting. Formula: lu_u(m)
# @param m: mat — Square n×n matrix
# @return mat — Upper-triangular matrix U
lu_u(m:mat)             -> mat = lu_helper(m, 1)
# @desc Computes the row-permutation matrix P in the PA = L · U decomposition with partial pivoting. Formula: lu_p(m)
# @param m: mat — Square n×n matrix
# @return mat — Permutation matrix P
lu_p(m:mat)             -> mat = lu_helper(m, 2)

# @desc Computes the orthonormal matrix Q in the Modified Gram-Schmidt QR decomposition M = Q · R. Formula: qr_q(m)
# @param m: mat — Input m×n matrix with linearly independent columns
# @return mat — Orthonormal matrix Q where Qᵀ · Q = I
qr_q(m:mat)             -> mat = {
    r := mat_rows(m)
    c := mat_cols(m)
    if (mat_rank(m) != 2 || r < c || c == 0) { error("QR decomposition requires a 2D matrix with rows >= cols") }
    Q := m.map(x => x)
    (j in 0..<c) {
        (i in 0..<j) {
            rij := 0
            (k in 0..<r) { rij += Q[k, i] * Q[k, j] }
            (k in 0..<r) { Q[k, j] = Q[k, j] - rij * Q[k, i] }
        }
        nrm := 0
        (k in 0..<r) { nrm += Q[k, j]^2 }
        nrm = √nrm
        if (nrm > 1e-14) {
            (k in 0..<r) { Q[k, j] = Q[k, j] / nrm }
        } else {
            (k in 0..<r) { Q[k, j] = 0 }
        }
    }
    Q
}

# @desc Computes the upper-triangular matrix R = Qᵀ · M in the QR decomposition M = Q · R. Formula: qr_r(m) = transpose(qr_q(m)) · m
# @param m: mat — Input m×n matrix
# @return mat — Upper-triangular factor matrix R
qr_r(m:mat)             -> mat = transpose(qr_q(m)) * m

# @desc Computes the lower-triangular Cholesky factor L of a symmetric positive-definite matrix M such that M = L · Lᵀ. Formula: chol(m)
# @param m: mat — Symmetric positive-definite n×n matrix
# @return mat — Lower-triangular Cholesky factor L
chol(m:mat)             -> mat = {
    n := mat_rows(m)
    if (mat_rank(m) != 2 || n != mat_cols(m) || n == 0) { error("chol() requires a non-empty square symmetric positive-definite matrix") }
    L := mat_zeros(n, n)
    (i in 0..<n) {
        (j in 0...i) {
            s := m[i, j]
            (k in 0..<j) { s -= L[i, k] * L[j, k] }
            if (i == j) {
                if (s <= 0) { error("chol() matrix is not positive-definite") }
                L[i, j] = √s
            } else {
                L[i, j] = s / L[j, j]
            }
        }
    }
    L
}

# @desc Computes `jacobi_helper(m: mat, mode: real)` in module [mat] (Matrix Decompositions (LU, QR, Cholesky, Eigenvalues/Vectors, SVD), Pseudoinverse, Least Squares & Norms).
# @param m: mat — Input matrix or map dictionary
# @param mode: real — Input parameter `mode` for `jacobi_helper`
# @return mat — Result returned by `jacobi_helper(m: mat, mode: real)` in [mat]
jacobi_helper(m:mat, mode) -> mat = {
    n := mat_rows(m)
    if (mat_rank(m) != 2 || n != mat_cols(m) || n == 0) { error("eigvals/eigvecs requires a square 2D matrix") }
    A := m.map(x => raw_val(x))
    V := mat_eye(n)
    (sweep in 0..<45) {
        off_norm := 0
        (p in 0..<n) {
            (q in (p + 1)..<n) {
                off_norm += A[p, q]^2
            }
        }
        if (off_norm < 1e-24) { break }
        (p in 0..<n) {
            (q in (p + 1)..<n) {
                apq := A[p, q]
                if (@abs(apq) >= 1e-15) {
                    app := A[p, p]
                    aqq := A[q, q]
                    tau := (aqq - app) / (2 * apq)
                    t   := (tau >= 0) ? (1 / (tau + √(1 + tau^2))) : (-1 / (-tau + √(1 + tau^2)))
                    c_r := 1 / √(1 + t^2)
                    s_r := t * c_r
                    A[p, p] = app - t * apq
                    A[q, q] = aqq + t * apq
                    A[p, q] = 0
                    A[q, p] = 0
                    (r in 0..<n) {
                        if (r != p && r != q) {
                            arp := A[r, p]
                            arq := A[r, q]
                            nrp := c_r * arp - s_r * arq
                            nrq := s_r * arp + c_r * arq
                            A[r, p] = nrp ; A[p, r] = nrp
                            A[r, q] = nrq ; A[q, r] = nrq
                        }
                        vrp := V[r, p]
                        vrq := V[r, q]
                        V[r, p] = c_r * vrp - s_r * vrq
                        V[r, q] = s_r * vrp + c_r * vrq
                    }
                }
            }
        }
    }
    (i in 0..<n) {
        best := i
        (j in (i + 1)..<n) {
            if (A[j, j] > A[best, best]) { best = j }
        }
        if (best != i) {
            tmp := A[i, i] ; A[i, i] = A[best, best] ; A[best, best] = tmp
            (r in 0..<n) {
                tv := V[r, i] ; V[r, i] = V[r, best] ; V[r, best] = tv
            }
        }
    }
    (mode == 0) ? A : V.map(x => (@abs(x) < 1e-14) ? 0 : x)
}

# @desc Computes the real eigenvalues of a symmetric square matrix using cyclic Jacobi rotations. Formula: eigvals(m)
# @param m: mat — Symmetric n×n matrix
# @return vec — Vector of n real eigenvalues
eigvals(m:mat) -> vec = {
    if (mat_rank(m) != 2 || mat_rows(m) != mat_cols(m) || mat_rows(m) == 0) {
        error("eigvals() requires a square 2D matrix")
    }
    n := mat_rows(m)
    if (n == 2) {
        a00 := raw_val(m[0, 0])
        a01 := raw_val(m[0, 1])
        a10 := raw_val(m[1, 0])
        a11 := raw_val(m[1, 1])
        tr  := a00 + a11
        dt  := a00 * a11 - a01 * a10
        dsc := tr * tr - 4 * dt
        if (dsc < -1e-11) { error("eigvals() matrix has complex eigenvalues") }
        if (dsc < 0) { dsc = 0 }
        sd  := √dsc
        e0  := 0.5 * (tr + sd)
        e1  := 0.5 * (tr - sd)
        out := vec(2, 0)
        out[0] = (@abs(e0) < 1e-14) ? 0 : e0
        out[1] = (@abs(e1) < 1e-14) ? 0 : e1
        return out
    }
    A := jacobi_helper(m, 0)
    [(@abs(A[i, i]) < 1e-13) ? 0 : A[i, i] for i in 0..<n]
}

# @desc Computes the orthonormal eigenvector matrix V (columns are eigenvectors) of a symmetric square matrix via Jacobi rotations. Formula: eigvecs(m)
# @param m: mat — Symmetric n×n matrix
# @return mat — n×n orthogonal matrix whose columns are the eigenvectors of `m`
eigvecs(m:mat) -> mat = jacobi_helper(m, 1)

# @desc Computes the singular values `[σ₁, σ₂, ...]` of matrix m in descending order. Formula: svd_s(m)
# @param m: mat — Rectangular m×n matrix
# @return vec — Vector of non-negative singular values sorted descending
svd_s(m:mat) -> vec = {
    if (mat_rank(m) != 2) { error("SVD requires a 2D matrix") }
    M   := mat_rows(m)
    N   := mat_cols(m)
    K   := min(M, N)
    D   := jacobi_helper(transpose(m) * m, 0)
    [(D[i, i] > 1e-24) ? √D[i, i] : 0 for i in 0..<K]
}

# @desc Computes the right singular vector matrix V in the Singular Value Decomposition M = U · Σ · Vᵀ. Formula: svd_v(m)
# @param m: mat — Input m×n matrix
# @return mat — Orthogonal right singular vector matrix V
svd_v(m:mat) -> mat = {
    if (mat_rank(m) != 2) { error("SVD requires a 2D matrix") }
    jacobi_helper(transpose(m) * m, 1)
}

# @desc Computes the left singular vector matrix U in the Singular Value Decomposition M = U · Σ · Vᵀ. Formula: svd_u(m)
# @param m: mat — Input m×n matrix
# @return mat — Orthonormal left singular vector matrix U
svd_u(m:mat) -> mat = {
    if (mat_rank(m) != 2) { error("SVD requires a 2D matrix") }
    M   := mat_rows(m)
    N   := mat_cols(m)
    ata := transpose(m) * m
    D   := jacobi_helper(ata, 0)
    V   := jacobi_helper(ata, 1)
    AV  := m * V
    U   := mat_zeros(M, N)
    (j in 0..<N) {
        lam := D[j, j]
        sj  := (lam > 1e-24) ? √lam : 0
        if (sj > 1e-12) {
            (r in 0..<M) {
                v := AV[r, j] / sj
                U[r, j] = (@abs(v) < 1e-14) ? 0 : v
            }
        }
    }
    U
}

# @desc Computes the Moore-Penrose pseudoinverse M⁺ of any rectangular m×n matrix via Singular Value Decomposition (SVD). Formula: pinv(m)
# @param m: mat — Rectangular m×n matrix
# @return mat — n×m Moore-Penrose pseudoinverse matrix M⁺
pinv(m:mat)             -> mat = {
    s    := svd_s(m)
    u    := svd_u(m)
    v    := svd_v(m)
    tol  := 1e-10 * max(1, s[0])
    sinv := [x > tol ? (1 / x) : 0 for x in s]
    v * diag(sinv) * transpose(u)
}

# @desc Computes the ordinary least-squares solution x = A⁺ · b minimizing ‖A·x − b‖₂ for an overdetermined or underdetermined linear system. Formula: lstsq(a, b) = pinv(a) · b
# @param a: mat — m×n design matrix A
# @param b: vec — m-element observation target vector b
# @return vec — n-element least-squares coefficient vector x
lstsq(a:mat, b:vec)     -> vec = pinv(a) * b
lstsq(a:mat, b:mat)     -> mat = pinv(a) * b

# @desc Approximates the dominant unit eigenvector of square matrix m using `steps` iterations of the power method. Formula: power_vec(m, steps = 40)
# @param m: mat — Square n×n matrix
# @param steps: int — Number of power-iteration steps (default 40)
# @return vec — Dominant unit eigenvector
power_vec(m:mat, steps = 40) -> vec = {
    n := mat_rows(m)
    if (n != mat_cols(m) || n == 0) { error("power_vec() requires a non-empty square matrix") }
    v := vec(n, 1)
    k := 0
    (k < steps) ?? {
        w  := m * v
        nv := norm(w)
        if (nv <= 1e-15) { break }
        v  = [x / nv for x in w]
        k += 1
    }
    v
}

# @desc Approximates the dominant eigenvalue λ_max of square matrix m using `steps` iterations of the power method. Formula: power_iter(m, steps = 40)
# @param m: mat — Square n×n matrix
# @param steps: int — Number of power-iteration steps (default 40)
# @return real — Dominant eigenvalue approximation λ_max
power_iter(m:mat, steps = 40) = {
    v := power_vec(m, steps)
    dot(v, m * v) / dot(v, v)
}

# @desc Computes the numerical rank of matrix m by counting singular values greater than tolerance `tol`. Formula: matrix_rank(m, tol = 1e-9)
# @param m: mat — Input matrix
# @param tol: real — Singular value cutoff threshold (default 1e-9)
# @return int — Numerical rank (number of linearly independent rows/columns)
matrix_rank(m:mat, tol = 1e-9) = {
    sv := svd_s(m)
    sv.count_if(s => s > tol)
}

# @desc Computes the L₂ spectral operator norm ‖M‖₂ (largest singular value σ_max) of matrix m. Formula: spectral_norm(m)
# @param m: mat — Input matrix
# @return real — Spectral norm σ_max(m) ≥ 0
spectral_norm(m:mat) = {
    sv := svd_s(m)
    sv[0]
}

# @desc Computes the L₂ condition number κ(M) = σ_max(M) / σ_min(M) measuring sensitivity of linear systems involving M. Formula: cond(m)
# @param m: mat — Input matrix
# @return real — Condition number κ(M) ≥ 1 (or ∞ if singular)
cond(m:mat) = {
    sv   := svd_s(m)
    smin := sv[sv.len() - 1]
    if (smin <= 1e-15) { error("Matrix is singular or rank-deficient (condition number is infinite)") }
    sv[0] / smin
}

# @desc Computes the induced L₁ matrix norm ‖M‖₁ (maximum absolute column sum) of matrix m. Formula: mat_norm1(m)
# @param m: mat — Input matrix
# @return real — Maximum absolute column sum ‖M‖₁ ≥ 0
mat_norm1(m:mat) = {
    r    := mat_rows(m)
    c    := mat_cols(m)
    best := 0
    (j in 0..<c) {
        s := 0
        (i in 0..<r) { s += @abs(m[i, j]) }
        if (s > best) { best = s }
    }
    best
}

# @desc Computes the induced L_∞ matrix norm ‖M‖_∞ (maximum absolute row sum) of matrix m. Formula: mat_norm_inf(m)
# @param m: mat — Input matrix
# @return real — Maximum absolute row sum ‖M‖_∞ ≥ 0
mat_norm_inf(m:mat) = {
    r    := mat_rows(m)
    c    := mat_cols(m)
    best := 0
    (i in 0..<r) {
        s := 0
        (j in 0..<c) { s += @abs(m[i, j]) }
        if (s > best) { best = s }
    }
    best
}

(a:mat) "==" (b:mat) :<30 = {
    if (mat_shape(a) != mat_shape(b)) { return 0 }
    flatten(a) == flatten(b)
}
(a:mat) "!=" (b:mat) :<30 = !(a == b)
(a:mat) "~"  (b:mat) :<30 = {
    if (mat_shape(a) != mat_shape(b)) { return 0 }
    flatten(a) ~ flatten(b)
}
