(x: real, krw) "into" (y: real, cad) :>55 = with_unit(@currency_convert("KRW", "CAD", x), y)
(x: real, krw) "into" (y: real, chf) :>55 = with_unit(@currency_convert("KRW", "CHF", x), y)
(x: real, krw) "into" (y: real, sgd) :>55 = with_unit(@currency_convert("KRW", "SGD", x), y)
(x: real, krw) "into" (y: real, hkd) :>55 = with_unit(@currency_convert("KRW", "HKD", x), y)
(x: real, krw) "into" (y: real, krw) :>55 = with_unit(x, y)
(x: real, krw) "into" (y: real, nzd) :>55 = with_unit(@currency_convert("KRW", "NZD", x), y)

# ---- NZD rows ----
(x: real, nzd) "into" (y: real, usd) :>55 = with_unit(@currency_convert("NZD", "USD", x), y)
(x: real, nzd) "into" (y: real, eur) :>55 = with_unit(@currency_convert("NZD", "EUR", x), y)
(x: real, nzd) "into" (y: real, gbp) :>55 = with_unit(@currency_convert("NZD", "GBP", x), y)
(x: real, nzd) "into" (y: real, inr) :>55 = with_unit(@currency_convert("NZD", "INR", x), y)
(x: real, nzd) "into" (y: real, jpy) :>55 = with_unit(@currency_convert("NZD", "JPY", x), y)
(x: real, nzd) "into" (y: real, cny) :>55 = with_unit(@currency_convert("NZD", "CNY", x), y)
(x: real, nzd) "into" (y: real, aud) :>55 = with_unit(@currency_convert("NZD", "AUD", x), y)
(x: real, nzd) "into" (y: real, cad) :>55 = with_unit(@currency_convert("NZD", "CAD", x), y)
(x: real, nzd) "into" (y: real, chf) :>55 = with_unit(@currency_convert("NZD", "CHF", x), y)
(x: real, nzd) "into" (y: real, sgd) :>55 = with_unit(@currency_convert("NZD", "SGD", x), y)
(x: real, nzd) "into" (y: real, hkd) :>55 = with_unit(@currency_convert("NZD", "HKD", x), y)
(x: real, nzd) "into" (y: real, krw) :>55 = with_unit(@currency_convert("NZD", "KRW", x), y)
(x: real, nzd) "into" (y: real, nzd) :>55 = with_unit(x, y)

# ==============================================================================
# 3. Plain function layer (ISO codes, no symbol aliases needed)
# ==============================================================================
# @desc Converts a monetary amount between any two 3-letter ISO-4217 currency codes using live/cached FX rates. Formula: convert(amount, from, to) = @currency_convert(from, to, amount)
# @param amount: real — Monetary amount in the source currency
# @param from: str — Source 3-letter ISO-4217 currency code (e.g. "USD")
# @param to: str — Target 3-letter ISO-4217 currency code (e.g. "INR")
# @return real — Converted amount in the target currency
convert(amount: real, from: str, to: str) = @currency_convert(from, to, amount)

# @desc Converts a monetary amount between two ISO-4217 currencies and formats it with the target currency code suffix. Formula: convert_str(amount, from, to) = fmt("%g %s", convert(amount, from, to), to)
# @param amount: real — Monetary amount in the source currency
# @param from: str — Source 3-letter ISO-4217 currency code
# @param to: str — Target 3-letter ISO-4217 currency code
# @return str — Formatted string showing the converted amount followed by the target ISO code
convert_str(amount: real, from: str, to: str) -> str = fmt("%g %s", convert(amount, from, to), to)

# @desc Converts every monetary amount in a vector from one ISO-4217 currency to another in a single batch call. Formula: convert_all(amounts, from, to) = [convert(a, from, to) for a in amounts]
# @param amounts: vec — Vector of numeric amounts denominated in the source currency
# @param from: str — Source 3-letter ISO-4217 currency code
# @param to: str — Target 3-letter ISO-4217 currency code
# @return vec — Vector of converted amounts in the target currency
convert_all(amounts: vec, from: str, to: str) -> vec = [convert(a, from, to) for a in amounts]

# @desc Returns the live/cached exchange rate multiplier (value of 1 unit of `from` in `to`). Formula: fx_rate(from, to) = @currency_convert(from, to, 1)
# @param from: str — Base 3-letter ISO-4217 currency code (e.g. "USD")
# @param to: str — Quote 3-letter ISO-4217 currency code (e.g. "INR")
# @return real — Exchange rate multiplier (1 unit of `from` expressed in `to`)
fx_rate(from: str, to: str) = @currency_convert(from, to, 1)
# @desc Converts a monetary amount between any two 3-letter ISO-4217 currency codes using live/cached FX rates. Formula: convert_fx(amount, from, to) = @currency_convert(from, to, amount)
# @param amount: real — Monetary amount in the source currency
# @param from: str — Source 3-letter ISO-4217 currency code (e.g. "USD")
# @param to: str — Target 3-letter ISO-4217 currency code (e.g. "INR")
# @return real — Converted amount in the target currency
convert_fx(amount: real, from: str, to: str) = @currency_convert(from, to, amount)

# @desc Converts a monetary amount from US Dollars (USD) to Indian Rupees (INR) using the live/cached exchange rate table. Formula: usd_to_inr(amount) = @currency_convert("USD", "INR", amount)
# @param amount: real — Monetary amount in US Dollars (USD)
# @return real — Equivalent monetary amount in Indian Rupees (INR)
usd_to_inr(amount: real) = @currency_convert("USD", "INR", amount)
# @desc Converts a monetary amount from Indian Rupees (INR) to US Dollars (USD) using the live/cached exchange rate table. Formula: inr_to_usd(amount) = @currency_convert("INR", "USD", amount)
# @param amount: real — Monetary amount in Indian Rupees (INR)
# @return real — Equivalent monetary amount in US Dollars (USD)
inr_to_usd(amount: real) = @currency_convert("INR", "USD", amount)
# @desc Converts a monetary amount from US Dollars (USD) to Euros (EUR) using the live/cached exchange rate table. Formula: usd_to_eur(amount) = @currency_convert("USD", "EUR", amount)
# @param amount: real — Monetary amount in US Dollars (USD)
# @return real — Equivalent monetary amount in Euros (EUR)
usd_to_eur(amount: real) = @currency_convert("USD", "EUR", amount)
# @desc Converts a monetary amount from Euros (EUR) to US Dollars (USD) using the live/cached exchange rate table. Formula: eur_to_usd(amount) = @currency_convert("EUR", "USD", amount)
# @param amount: real — Monetary amount in Euros (EUR)
# @return real — Equivalent monetary amount in US Dollars (USD)
eur_to_usd(amount: real) = @currency_convert("EUR", "USD", amount)
# @desc Converts a monetary amount from US Dollars (USD) to British Pounds (GBP) using the live/cached exchange rate table. Formula: usd_to_gbp(amount) = @currency_convert("USD", "GBP", amount)
# @param amount: real — Monetary amount in US Dollars (USD)
# @return real — Equivalent monetary amount in British Pounds (GBP)
usd_to_gbp(amount: real) = @currency_convert("USD", "GBP", amount)
# @desc Converts a monetary amount from British Pounds (GBP) to US Dollars (USD) using the live/cached exchange rate table. Formula: gbp_to_usd(amount) = @currency_convert("GBP", "USD", amount)
# @param amount: real — Monetary amount in British Pounds (GBP)
# @return real — Equivalent monetary amount in US Dollars (USD)
gbp_to_usd(amount: real) = @currency_convert("GBP", "USD", amount)
