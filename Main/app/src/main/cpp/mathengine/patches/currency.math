# ==============================================================================
# patches/currency.math – Currency Conversion Foundation (`[currency]`)
# ==============================================================================
[currency]
<[boot_types]
<[arith]
<[string]

# ==============================================================================
# 1. Currency symbol & code aliases (each marker is its own unit group so
#    `unit_of(5$) == "usd"` lets `currency_convert` see the source currency)
#
#    Registry budget: this base file defines 13 currency groups, which keeps the
#    whole base exactly inside the OLD (SYM_MAX_UNITS=64) engine's 47 owned
#    named-group slots (34 stdlib + 13 currency), so every shipped APK can load
#    it. The remaining 42 baseline currencies live in `currency_pairs_N.math`
#    and require the SYM_MAX_UNITS=128 engine (they fail gracefully per-file on
#    older engines via the patch loader).
#
#    NOTE: TRY's lowercase identifier collides with the reserved keywords
#    (`try`), so its group is named `lira` and only `TRY` / `₺` are spelled.
#    The ¥ alias maps to JPY only (matching the host symbol table); CNY is
#    spelled by its codes.
# ==============================================================================
(x)    "$"  :95 -> real, usd = x
(x)    "US$" :95 -> real, usd = x
(x)    USD  :95 -> real, usd = x
(x)    usd  :95 -> real, usd = x
(x)    "€"  :95 -> real, eur = x
(x)    EUR  :95 -> real, eur = x
(x)    eur  :95 -> real, eur = x
(x)    "£"  :95 -> real, gbp = x
(x)    GBP  :95 -> real, gbp = x
(x)    gbp  :95 -> real, gbp = x
(x)    "Rs" :95 -> real, inr = x
(x)    "RS" :95 -> real, inr = x
(x)    "rs" :95 -> real, inr = x
(x)    "₹"  :95 -> real, inr = x
(x)    INR  :95 -> real, inr = x
(x)    inr  :95 -> real, inr = x
(x)    "¥"  :95 -> real, jpy = x
(x)    JPY  :95 -> real, jpy = x
(x)    jpy  :95 -> real, jpy = x
(x)    CNY  :95 -> real, cny = x
(x)    cny  :95 -> real, cny = x
(x)    "A$" :95 -> real, aud = x
(x)    AUD  :95 -> real, aud = x
(x)    aud  :95 -> real, aud = x
(x)    "C$" :95 -> real, cad = x
(x)    CAD  :95 -> real, cad = x
(x)    cad  :95 -> real, cad = x
(x)    CHF  :95 -> real, chf = x
(x)    chf  :95 -> real, chf = x
(x)    "S$" :95 -> real, sgd = x
(x)    SGD  :95 -> real, sgd = x
(x)    sgd  :95 -> real, sgd = x
(x)    "HK$":95 -> real, hkd = x
(x)    HKD  :95 -> real, hkd = x
(x)    hkd  :95 -> real, hkd = x
(x)    "₩"  :95 -> real, krw = x
(x)    KRW  :95 -> real, krw = x
(x)    krw  :95 -> real, krw = x
(x)    "NZ$":95 -> real, nzd = x
(x)    NZD  :95 -> real, nzd = x
(x)    nzd  :95 -> real, nzd = x

# Bare constants (RHS of `into`): `25$ into RS` / `25$ into Rs` – the right side
# resolves as a 1-unit value tagged with the target currency.
"$"   : real, usd = 1
"US$" : real, usd = 1
"USD" : real, usd = 1
"usd" : real, usd = 1
"EUR" : real, eur = 1
"eur" : real, eur = 1
"GBP" : real, gbp = 1
"gbp" : real, gbp = 1
"Rs"  : real, inr = 1
"RS"  : real, inr = 1
"rs"  : real, inr = 1
"INR" : real, inr = 1
"inr" : real, inr = 1
"JPY" : real, jpy = 1
"jpy" : real, jpy = 1
"CNY" : real, cny = 1
"cny" : real, cny = 1
"A$"  : real, aud = 1
"AUD" : real, aud = 1
"aud" : real, aud = 1
"C$"  : real, cad = 1
"CAD" : real, cad = 1
"cad" : real, cad = 1
"CHF" : real, chf = 1
"chf" : real, chf = 1
"S$"  : real, sgd = 1
"SGD" : real, sgd = 1
"sgd" : real, sgd = 1
"HK$" : real, hkd = 1
"HKD" : real, hkd = 1
"hkd" : real, hkd = 1
"₩"   : real, krw = 1
"KRW" : real, krw = 1
"krw" : real, krw = 1
"NZ$" : real, nzd = 1
"NZD" : real, nzd = 1
"nzd" : real, nzd = 1

# ==============================================================================
# 2. `from into to` conversion overloads (`25$ into RS`, `100 USD into EUR`, ...)
#    `with_unit` (`@raw`) passes fallback `$str` messages through untouched.
#    This block covers the full 13x13 matrix of base currencies; the remaining
#    42 currencies' rows are in `currency_pairs_N.math` (generated).
# ==============================================================================
# ---- USD rows ----
(x: real, usd) "into" (y: real, usd) :>55 = with_unit(x, y)
(x: real, usd) "into" (y: real, eur) :>55 = with_unit(@currency_convert("USD", "EUR", x), y)
(x: real, usd) "into" (y: real, gbp) :>55 = with_unit(@currency_convert("USD", "GBP", x), y)
(x: real, usd) "into" (y: real, inr) :>55 = with_unit(@currency_convert("USD", "INR", x), y)
(x: real, usd) "into" (y: real, jpy) :>55 = with_unit(@currency_convert("USD", "JPY", x), y)
(x: real, usd) "into" (y: real, cny) :>55 = with_unit(@currency_convert("USD", "CNY", x), y)
(x: real, usd) "into" (y: real, aud) :>55 = with_unit(@currency_convert("USD", "AUD", x), y)
(x: real, usd) "into" (y: real, cad) :>55 = with_unit(@currency_convert("USD", "CAD", x), y)
(x: real, usd) "into" (y: real, chf) :>55 = with_unit(@currency_convert("USD", "CHF", x), y)
(x: real, usd) "into" (y: real, sgd) :>55 = with_unit(@currency_convert("USD", "SGD", x), y)
(x: real, usd) "into" (y: real, hkd) :>55 = with_unit(@currency_convert("USD", "HKD", x), y)
(x: real, usd) "into" (y: real, krw) :>55 = with_unit(@currency_convert("USD", "KRW", x), y)
(x: real, usd) "into" (y: real, nzd) :>55 = with_unit(@currency_convert("USD", "NZD", x), y)

