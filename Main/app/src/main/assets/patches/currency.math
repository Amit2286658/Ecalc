# ==============================================================================
# patches/currency.math – Currency Conversion Foundation (`[currency]`)
# ==============================================================================
[currency]
<[boot_types]
<[arith]
<[string]

# ==============================================================================
# 1. Currency symbol & code aliases (each marker is its own unit group so
#    `unit_of(5$) == "usd"` lets `currency_convert` see the source currency)
# ==============================================================================
(x)    "$"  :95 -> real, usd = x
(x)    USD  :95 -> real, usd = x
(x)    "€"  :95 -> real, eur = x
(x)    EUR  :95 -> real, eur = x
(x)    "£"  :95 -> real, gbp = x
(x)    GBP  :95 -> real, gbp = x
(x)    "Rs" :95 -> real, inr = x
(x)    "₹"  :95 -> real, inr = x
(x)    INR  :95 -> real, inr = x
(x)    "¥"  :95 -> real, jpy = x
(x)    JPY  :95 -> real, jpy = x

# Bare constants (RHS of `into`): `5$ into Rs` – the right side resolves as a
# 1-unit value tagged with the target currency.
"USD" : real, usd = 1
"EUR" : real, eur = 1
"GBP" : real, gbp = 1
"Rs"  : real, inr = 1
"INR" : real, inr = 1
"JPY" : real, jpy = 1

# ==============================================================================
# 2. `from into to` conversion overloads (`5$ into Rs`, `100 USD into EUR`, ...)
#    `with_unit` (`@raw`) passes fallback `$str` messages through untouched.
# ==============================================================================
(x: real, usd) "into" (y: real, eur) :>55 = with_unit(@currency_convert("USD", "EUR", x), y)
(x: real, usd) "into" (y: real, gbp) :>55 = with_unit(@currency_convert("USD", "GBP", x), y)
(x: real, usd) "into" (y: real, inr) :>55 = with_unit(@currency_convert("USD", "INR", x), y)
(x: real, usd) "into" (y: real, jpy) :>55 = with_unit(@currency_convert("USD", "JPY", x), y)

(x: real, eur) "into" (y: real, usd) :>55 = with_unit(@currency_convert("EUR", "USD", x), y)
(x: real, eur) "into" (y: real, gbp) :>55 = with_unit(@currency_convert("EUR", "GBP", x), y)
(x: real, eur) "into" (y: real, inr) :>55 = with_unit(@currency_convert("EUR", "INR", x), y)
(x: real, eur) "into" (y: real, jpy) :>55 = with_unit(@currency_convert("EUR", "JPY", x), y)

(x: real, gbp) "into" (y: real, usd) :>55 = with_unit(@currency_convert("GBP", "USD", x), y)
(x: real, gbp) "into" (y: real, eur) :>55 = with_unit(@currency_convert("GBP", "EUR", x), y)
(x: real, gbp) "into" (y: real, inr) :>55 = with_unit(@currency_convert("GBP", "INR", x), y)
(x: real, gbp) "into" (y: real, jpy) :>55 = with_unit(@currency_convert("GBP", "JPY", x), y)

(x: real, inr) "into" (y: real, usd) :>55 = with_unit(@currency_convert("INR", "USD", x), y)
(x: real, inr) "into" (y: real, eur) :>55 = with_unit(@currency_convert("INR", "EUR", x), y)
(x: real, inr) "into" (y: real, gbp) :>55 = with_unit(@currency_convert("INR", "GBP", x), y)
(x: real, inr) "into" (y: real, jpy) :>55 = with_unit(@currency_convert("INR", "JPY", x), y)

(x: real, jpy) "into" (y: real, usd) :>55 = with_unit(@currency_convert("JPY", "USD", x), y)
(x: real, jpy) "into" (y: real, eur) :>55 = with_unit(@currency_convert("JPY", "EUR", x), y)
(x: real, jpy) "into" (y: real, gbp) :>55 = with_unit(@currency_convert("JPY", "GBP", x), y)
(x: real, jpy) "into" (y: real, inr) :>55 = with_unit(@currency_convert("JPY", "INR", x), y)

# ==============================================================================
# 3. Plain function layer (ISO codes, no symbol aliases needed)
# ==============================================================================
convert(amount: real, from: str, to: str) = @currency_convert(from, to, amount)

# Ready-to-display string form: "(converted) <to>"
convert_str(amount: real, from: str, to: str) -> str = fmt("%g %s", convert(amount, from, to), to)

# Batch form: convert a vec of `from`-denominated amounts in one call.
convert_all(amounts: vec, from: str, to: str) -> vec = [convert(a, from, to) for a in amounts]

# Live exchange rate & calculator convenience aliases
fx_rate(from: str, to: str) = @currency_convert(from, to, 1)
convert_fx(amount: real, from: str, to: str) = @currency_convert(from, to, amount)
