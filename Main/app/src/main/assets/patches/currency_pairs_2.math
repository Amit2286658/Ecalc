# ==============================================================================
# patches/currency_pairs_2.math — currency `into` matrix [2/len(files)]
# Covers: TRY, AED, SAR, THB, MYR, IDR, PHP
# Generated by tools/gen_currency_pairs.py — DO NOT EDIT BY HAND.
# Requires the SYM_MAX_UNITS=128 unit registry (older engines skip this
# file gracefully via the patch loader).
# ==============================================================================

[currency_pairs_2]
