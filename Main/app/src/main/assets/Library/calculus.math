# =============================================================================
# Library/calculus.math — High School Differential & Integral Calculus Suite
# =============================================================================
# All numerical differentiation (`diff`, `diff2`, `diff_n`), Simpson quadrature
# (`integrate`, `ntg`), Richardson limits (`lim`, `lim_left`, `lim_right`),
# discrete series (`sigma`, `prod`), Newton-secant root solving (`solve`),
# golden-section extrema (`fmin`, `fmax`), and 4th-order Runge-Kutta ODE solvers
# (`ode_rk4`, `ode_rk4_vec`, `ode_coupled2`, `ode_coupled3`, `ode_rk4_sys`,
# `ode_rk4_sys_traj`) are implemented in pure `.math` using lazy bound-variable
# parameters (`var_x`, `var_t`, `var_y`, ...) and preserve physical units.

[calculus]
<[arith]
<[trig]
<[vec]
<[mat]
<[string]
<[geom_ext]
<[algebra]

# @desc Snaps numerical calculus results close to an integer or zero within tolerance tol while preserving 7D SI physical units. Formula: calc_snap(res, tol = 1e-9)
# @param res: real — Numerical result value (with optional physical SI units) to snap
# @param tol: real — Absolute snapping tolerance around integers and zero (default 1e-9)
# @return real — Unit-preserving value snapped to the nearest integer (or 0) when within tol
calc_snap(res, tol) = {
    r := raw_val(res)
    n := @floor(r + 0.5)
    s := (@abs(r - n) < tol) ? n : ((@abs(r) < tol * 0.1) ? 0 : r)
    with_unit(s, res)
}

# @desc Computes the numerical first derivative df/dx of `expr` with respect to `var_x` evaluated at `x0` using high-accuracy central differences. Formula: diff(var_x, expr, x0)
# @param var_x: ident — Differentiation variable symbol (e.g. `x`)
# @param expr: ast — Symbolic expression f(x) to differentiate
# @param x0: real — Point at which df/dx is evaluated
# @return real — Numerical first derivative f'(x0)
diff(var_x, expr, x0) = {
    scale := (@abs(raw_val(x0)) > 1) ? @abs(raw_val(x0)) : 1
    h     := with_unit(1e-5 * scale, x0)
    fp2   := expr(x0 + 2 * h)
    fp1   := expr(x0 + h)
    fm1   := expr(x0 - h)
    fm2   := expr(x0 - 2 * h)
    calc_snap((-fp2 + 8 * fp1 - 8 * fm1 + fm2) / (12 * h), 1e-9)
}

# @desc Computes the numerical second derivative d²f/dx² of `expr` with respect to `var_x` evaluated at `x0`. Formula: diff2(var_x, expr, x0)
# @param var_x: ident — Differentiation variable symbol (e.g. `x`)
# @param expr: ast — Symbolic expression f(x) to differentiate twice
# @param x0: real — Point at which f''(x0) is evaluated
# @return real — Numerical second derivative f''(x0)
diff2(var_x, expr, x0) = {
    scale := (@abs(raw_val(x0)) > 1) ? @abs(raw_val(x0)) : 1
    h     := with_unit(1e-4 * scale, x0)
    fp2   := expr(x0 + 2 * h)
    fp1   := expr(x0 + h)
    f0    := expr(x0)
    fm1   := expr(x0 - h)
    fm2   := expr(x0 - 2 * h)
    calc_snap((-fp2 + 16 * fp1 - 30 * f0 + 16 * fm1 - fm2) / (12 * h * h), 1e-7)
}

# @desc Computes the n-th numerical derivative dⁿf/dxⁿ of `expr` with respect to `var_x` at `x0`. Formula: diff_n(var_x, expr, x0, order)
# @param var_x: ident — Differentiation variable symbol (e.g. `x`)
# @param expr: ast — Expression f(x) to differentiate
# @param x0: real — Evaluation point x₀
# @param order: int — Derivative order n (1, 2, 3, ...)
# @return real — Numerical n-th derivative f^(n)(x0)
diff_n(var_x, expr, x0, order) = {
    scale := (@abs(raw_val(x0)) > 1) ? @abs(raw_val(x0)) : 1
    if (order <= 0) {
        expr(x0)
    } or (order == 1) {
        h := with_unit(1e-5 * scale, x0)
        calc_snap((-expr(x0 + 2 * h) + 8 * expr(x0 + h) - 8 * expr(x0 - h) + expr(x0 - 2 * h)) / (12 * h), 1e-9)
    } or (order == 2) {
        h := with_unit(1e-4 * scale, x0)
        calc_snap((-expr(x0 + 2 * h) + 16 * expr(x0 + h) - 30 * expr(x0) + 16 * expr(x0 - h) - expr(x0 - 2 * h)) / (12 * h * h), 1e-7)
    } or (order == 3) {
        h := with_unit(1e-3 * scale, x0)
        calc_snap((expr(x0 + 2 * h) - 2 * expr(x0 + h) + 2 * expr(x0 - h) - expr(x0 - 2 * h)) / (2 * h * h * h), 1e-5)
    } else {
        h := with_unit(2e-3 * scale, x0)
        calc_snap((expr(x0 + 2 * h) - 4 * expr(x0 + h) + 6 * expr(x0) - 4 * expr(x0 - h) + expr(x0 - 2 * h)) / (h * h * h * h), 1e-4)
    }
}

# @desc Computes `calc_integ_fn(f: fn, a: real, b: real, steps: real = 200)` in module [calculus] (Unit-Preserving Noise Snapping & Core Lazy Calculus Constructs).
# @param f: fn — Callable function or lambda `x => ...`
# @param a: real — First input operand, vector, or matrix
# @param b: real — Second input operand, vector, or matrix
# @param steps: real — Number of numerical integration or iteration steps (default 200)
# @return any — Result returned by `calc_integ_fn(f: fn, a: real, b: real, steps: real = 200)` in [calculus]
calc_integ_fn(f:fn, a, b, steps = 200) = {
    n := @floor(steps)
    if (n < 2) { n = 2 }
    if (n % 2 != 0) { n += 1 }
    if (n > 10000) { n = 10000 }
    h   := (b - a) / n
    a_u := a + 0 * h
    b_u := b + 0 * h
    acc := f(a_u) + f(b_u)
    (k in 1..<n) {
        xk  := a_u + k * h
        w   := (k % 2 == 1) ? 4 : 2
        acc += w * f(xk)
    }
    calc_snap((h / 3) * acc, 1e-9)
}

# @desc Computes the definite integral ∫[a..b] expr d(var_x) numerically via composite Simpson's 1/3 rule. Formula: integrate(var_x, expr, a, b, steps = 200)
# @param var_x: ident — Integration dummy variable (e.g. `x`)
# @param expr: ast — Integrand expression f(x)
# @param a: real — Lower limit of integration
# @param b: real — Upper limit of integration
# @param steps: int — Number of subintervals (default 200)
# @return real — Numerical definite integral ∫[a..b] f(x) dx
integrate(var_x, expr, a, b, steps = 200) = calc_integ_fn(expr, a, b, steps)
# @desc Shorthand alias for `integrate(var_x, expr, a, b)` computing the numerical definite integral ∫[a..b] expr d(var_x). Formula: ntg(var_x, expr, a, b)
# @param var_x: ident — Integration dummy variable (e.g. `x`)
# @param expr: ast — Integrand expression f(x)
# @param a: real — Lower limit of integration
# @param b: real — Upper limit of integration
# @return real — Numerical definite integral ∫[a..b] f(x) dx
ntg(var_x, expr, a, b)                    = calc_integ_fn(expr, a, b, 200)

# @desc Computes the right-hand one-sided limit lim_{var_x → x0⁺} expr approaching x0 from above. Formula: lim_right(var_x, expr, x0)
# @param var_x: ident — Approaching variable symbol (e.g. `x`)
# @param expr: ast — Expression f(x)
# @param x0: real — Target point approached from the right (var_x > x0)
# @return real — Right-hand limit value lim_{x → x0⁺} f(x)
lim_right(var_x, expr, x0) = {
    scale := (@abs(raw_val(x0)) > 1) ? @abs(raw_val(x0)) : 1
    h1    := with_unit(1e-6 * scale, x0)
    h2    := with_unit(1e-7 * scale, x0)
    r1    := expr(x0 + h1)
    r2    := expr(x0 + h2)
    calc_snap((10 * r2 - r1) / 9, 1e-8)
}

# @desc Computes the left-hand one-sided limit lim_{var_x → x0⁻} expr approaching x0 from below. Formula: lim_left(var_x, expr, x0)
# @param var_x: ident — Approaching variable symbol (e.g. `x`)
# @param expr: ast — Expression f(x)
# @param x0: real — Target point approached from the left (var_x < x0)
# @return real — Left-hand limit value lim_{x → x0⁻} f(x)
lim_left(var_x, expr, x0) = {
    scale := (@abs(raw_val(x0)) > 1) ? @abs(raw_val(x0)) : 1
    h1    := with_unit(1e-6 * scale, x0)
    h2    := with_unit(1e-7 * scale, x0)
    l1    := expr(x0 - h1)
    l2    := expr(x0 - h2)
    calc_snap((10 * l2 - l1) / 9, 1e-8)
}

# @desc Computes the two-sided numerical limit lim_{var_x → x0} expr using Richardson-extrapolated geometric step halving. Formula: lim(var_x, expr, x0)
# @param var_x: ident — Approaching variable symbol (e.g. `x`)
# @param expr: ast — Expression f(x) whose limit is evaluated
# @param x0: real — Target limit point x₀
# @return real — Two-sided limit value as var_x → x0
lim(var_x, expr, x0) = {
    scale := (@abs(raw_val(x0)) > 1) ? @abs(raw_val(x0)) : 1
    h1    := with_unit(1e-6 * scale, x0)
    h2    := with_unit(1e-7 * scale, x0)
    r1    := expr(x0 + h1)
    r2    := expr(x0 + h2)
    l1    := expr(x0 - h1)
    l2    := expr(x0 - h2)
    lim_r := (10 * r2 - r1) / 9
    lim_l := (10 * l2 - l1) / 9
    tol   := 1e-4 * (1 + @abs(raw_val(lim_r)) + @abs(raw_val(lim_l)))
    if (@abs(raw_val(lim_r) - raw_val(lim_l)) > tol) {
        error("Two-sided limit does not exist")
    }
    calc_snap(0.5 * (lim_l + lim_r), 1e-8)
}

# @desc Evaluates the discrete summation ∑_{var_k = lo}^{hi} expr over integer index `var_k`. Formula: sigma(var_k, expr, lo, hi)
# @param var_k: ident — Summation index variable (e.g. `k`)
# @param expr: ast — Term expression a(k) evaluated at each integer k
# @param lo: int — Lower integer index bound (inclusive)
# @param hi: int — Upper integer index bound (inclusive)
# @return real — Discrete sum ∑_{k=lo..hi} a(k)
sigma(var_k, expr, lo, hi) = {
    k_lo := @floor(lo + 0.5)
    k_hi := @floor(hi + 0.5)
    if (k_lo > k_hi) {
        0
    } else {
        acc := expr(k_lo)
        k   := k_lo + 1
        (k <= k_hi) ?? {
            acc = acc + expr(k)
            k  += 1
        }
        acc
    }
}

# @desc Evaluates the discrete product ∏_{var_k = lo}^{hi} expr over integer index `var_k`. Formula: prod(var_k, expr, lo, hi)
# @param var_k: ident — Product index variable (e.g. `k`)
# @param expr: ast — Factor expression a(k) evaluated at each integer k
# @param lo: int — Lower integer index bound (inclusive)
# @param hi: int — Upper integer index bound (inclusive)
# @return real — Discrete product ∏_{k=lo..hi} a(k)
prod(var_k, expr, lo, hi) = {
    k_lo := @floor(lo + 0.5)
    k_hi := @floor(hi + 0.5)
    if (k_lo > k_hi) {
        1
    } else {
        acc := expr(k_lo)
        k   := k_lo + 1
        (k <= k_hi) ?? {
            acc = acc * expr(k)
            k  += 1
        }
        acc
    }
}

# @desc Computes `solve_impl(f: fn, x_init: real)` in module [calculus] (Unit-Preserving Noise Snapping & Core Lazy Calculus Constructs).
# @param f: fn — Callable function or lambda `x => ...`
# @param x_init: real — Input parameter `x_init` for `solve_impl`
# @return any — Result returned by `solve_impl(f: fn, x_init: real)` in [calculus]
solve_impl(f:fn, x_init) = {
    xr   := raw_val(x_init)
    iter := 0
    (iter < 80) ?? {
        fx := raw_val(f(with_unit(xr, x_init)))
        if (@abs(fx) <= 1e-12) { break }
        scale := (@abs(xr) > 1) ? @abs(xr) : 1
        h     := 1e-6 * scale
        fp    := raw_val(f(with_unit(xr + h, x_init)))
        fm    := raw_val(f(with_unit(xr - h, x_init)))
        dfx   := (fp - fm) / (2 * h)
        if (@abs(dfx) <= 1e-12) {
            xr += (xr >= 0) ? 0.25 : -0.25
        } else {
            step := fx / dfx
            if (step > 100)  { step = 100 }
            if (step < -100) { step = -100 }
            xr -= step
        }
        iter += 1
    }
    fx_end := raw_val(f(with_unit(xr, x_init)))
    if (!(@abs(xr) < 1e300) || !(@abs(fx_end) <= 1e-4)) {
        error("solve() failed to converge to a real root")
    }
    with_unit(calc_snap(xr, 1e-8), x_init)
}

# @desc Finds a numerical root of equation `eq` (e.g. `f(x) == g(x)` or `f(x)`) for variable `var_x` starting from initial estimate `guess`. Formula: solve(var_x, eq, guess = 1)
# @param var_x: ident — Unknown variable symbol to solve for (e.g. `x`)
# @param eq: ast — Equation `lhs == rhs` or residual expression `f(x)`
# @param guess: real — Initial root estimate (default 1)
# @return real — Numerical root `var_x` satisfying `eq`
solve(var_x, eq, guess = 1) = solve_impl(eq, guess)
solve(var_x, eq, a, b)      = solve_impl(eq, 0.5 * (a + b))

# @desc Computes `calc_extremum(f: fn, a_in: real, b_in: real, is_min: real)` in module [calculus] (Unit-Preserving Noise Snapping & Core Lazy Calculus Constructs).
# @param f: fn — Callable function or lambda `x => ...`
# @param a_in: real — Input parameter `a_in` for `calc_extremum`
# @param b_in: real — Input parameter `b_in` for `calc_extremum`
# @param is_min: real — Input parameter `is_min` for `calc_extremum`
# @return any — Result returned by `calc_extremum(f: fn, a_in: real, b_in: real, is_min: real)` in [calculus]
calc_extremum(f:fn, a_in, b_in, is_min) = {
    u_x := b_in - a_in
    a   := raw_val(a_in)
    b   := raw_val(b_in)
    if (a > b) { tmp := a ; a = b ; b = tmp }
    invphi := 0.6180339887498948482
    c  := b - invphi * (b - a)
    d  := a + invphi * (b - a)
    fc := raw_val(f(with_unit(c, u_x)))
    fd := raw_val(f(with_unit(d, u_x)))
    iter := 0
    (iter < 75) ?? {
        pick_left := is_min ? (fc < fd) : (fc > fd)
        if (pick_left) {
            b  = d
            d  = c
            fd = fc
            c  = b - invphi * (b - a)
            fc = raw_val(f(with_unit(c, u_x)))
        } else {
            a  = c
            c  = d
            fc = fd
            d  = a + invphi * (b - a)
            fd = raw_val(f(with_unit(d, u_x)))
        }
        iter += 1
    }
    with_unit(calc_snap(0.5 * (a + b), 1e-6), u_x)
}

# @desc Finds the local minimum x* of `expr` with respect to `var_x` on the interval [a, b] via golden-section search. Formula: fmin(var_x, expr, a, b)
# @param var_x: ident — Optimization variable symbol (e.g. `x`)
# @param expr: ast — Objective expression f(x) to minimize
# @param a: real — Left interval endpoint
# @param b: real — Right interval endpoint
# @return real — Minimizer coordinate x* ∈ [a, b]
fmin(var_x, expr, a, b) = calc_extremum(expr, a, b, 1)
# @desc Finds the local maximum x* of `expr` with respect to `var_x` on the interval [a, b] via golden-section search. Formula: fmax(var_x, expr, a, b)
# @param var_x: ident — Optimization variable symbol (e.g. `x`)
# @param expr: ast — Objective expression f(x) to maximize
# @param a: real — Left interval endpoint
# @param b: real — Right interval endpoint
# @return real — Maximizer coordinate x* ∈ [a, b]
fmax(var_x, expr, a, b) = calc_extremum(expr, a, b, 0)

# @desc Integrates the initial-value ODE dy/dt = expr(t, y) from (t0, y0) to t1 using the classical 4th-order Runge-Kutta (RK4) method. Formula: ode_rk4(var_t, var_y, expr, t0, y0, t1, steps = 100)
# @param var_t: ident — Independent time variable symbol (e.g. `t`)
# @param var_y: ident — Dependent state variable symbol (e.g. `y`)
# @param expr: ast — Derivative right-hand side f(t, y)
# @param t0: real — Initial time t₀
# @param y0: real — Initial state y(t₀) = y₀
# @param t1: real — Final target time t₁
# @param steps: int — Number of RK4 integration steps (default 100)
# @return real — Integrated state value y(t₁)
ode_rk4(var_t, var_y, expr, t0, y0, t1, steps = 100) = {
    n := @floor(steps)
    if (n < 1) { n = 1 }
    if (n > 4096) { n = 4096 }
    h     := (t1 - t0) / n
    hr    := raw_val(h)
    t_cur := t0 + 0 * h
    y_cur := raw_val(y0)
    i     := 0
    (i < n) ?? {
        k1 := raw_val(expr(t_cur, with_unit(y_cur, y0)))
        k2 := raw_val(expr(t_cur + 0.5 * h, with_unit(y_cur + 0.5 * hr * k1, y0)))
        k3 := raw_val(expr(t_cur + 0.5 * h, with_unit(y_cur + 0.5 * hr * k2, y0)))
        k4 := raw_val(expr(t_cur + h, with_unit(y_cur + hr * k3, y0)))
        y_cur += (hr / 6) * (k1 + 2 * k2 + 2 * k3 + k4)
        t_cur += h
        i     += 1
    }
    with_unit(calc_snap(y_cur, 1e-9), y0)
}

# @desc Integrates dy/dt = expr(t, y) via 4th-order Runge-Kutta and returns the full trajectory vector of y-values across all steps. Formula: ode_rk4_vec(var_t, var_y, expr, t0, y0, t1, steps = 10)
# @param var_t: ident — Time variable symbol
# @param var_y: ident — State variable symbol
# @param expr: ast — Derivative expression f(t, y)
# @param t0: real — Start time t₀
# @param y0: real — Initial state y₀
# @param t1: real — End time t₁
# @param steps: int — Number of trajectory steps (default 10)
# @return vec — Vector of state values `[y(t0), ..., y(t1)]` along the integration path
ode_rk4_vec(var_t, var_y, expr, t0, y0, t1, steps = 10) -> vec = {
    n := @floor(steps)
    if (n < 1) { n = 1 }
    if (n > 4096) { n = 4096 }
    h     := (t1 - t0) / n
    hr    := raw_val(h)
    t_cur := t0 + 0 * h
    y_cur := raw_val(y0)
    traj  := vec()
    with_unit(calc_snap(y_cur, 1e-9), y0) into traj
    i := 0
    (i < n) ?? {
        k1 := raw_val(expr(t_cur, with_unit(y_cur, y0)))
        k2 := raw_val(expr(t_cur + 0.5 * h, with_unit(y_cur + 0.5 * hr * k1, y0)))
        k3 := raw_val(expr(t_cur + 0.5 * h, with_unit(y_cur + 0.5 * hr * k2, y0)))
        k4 := raw_val(expr(t_cur + h, with_unit(y_cur + hr * k3, y0)))
        y_cur += (hr / 6) * (k1 + 2 * k2 + 2 * k3 + k4)
        t_cur += h
        with_unit(calc_snap(y_cur, 1e-9), y0) into traj
        i += 1
    }
    traj
}

# @desc Computes `ode_coupled2(var_t: real, var_x: real, var_y: real, dx: real, dy: real, t0: real, x0: real, y0: real, t1: real, steps: real = 100)` in module [calculus] (Unit-Preserving Noise Snapping & Core Lazy Calculus Constructs).
# @param var_t: real — Independent time variable identifier (e.g. `t`)
# @param var_x: real — Symbolic variable identifier (e.g. `x`)
# @param var_y: real — State variable identifier (e.g. `y`)
# @param dx: real — Input parameter `dx` for `ode_coupled2`
# @param dy: real — Input parameter `dy` for `ode_coupled2`
# @param t0: real — Initial starting time t₀
# @param x0: real — Evaluation point or initial root/state estimate
# @param y0: real — Initial Y coordinate or initial state value
# @param t1: real — Target final time t₁
# @param steps: real — Number of numerical integration or iteration steps (default 100)
# @return vec — Result returned by `ode_coupled2(var_t: real, var_x: real, var_y: real, dx: real, dy: real, t0: real, x0: real, y0: real, t1: real, steps: real = 100)` in [calculus]
ode_coupled2(var_t, var_x, var_y, dx, dy, t0, x0, y0, t1, steps = 100) -> vec = {
    n := @floor(steps)
    if (n < 1) { n = 1 }
    if (n > 4096) { n = 4096 }
    h  := (t1 - t0) / n
    tc := t0
    xc := x0
    yc := y0
    s  := 0
    (s < n) ?? {
        k1x := dx(tc, xc, yc)
        k1y := dy(tc, xc, yc)
        k2x := dx(tc + 0.5 * h, xc + 0.5 * h * k1x, yc + 0.5 * h * k1y)
        k2y := dy(tc + 0.5 * h, xc + 0.5 * h * k1x, yc + 0.5 * h * k1y)
        k3x := dx(tc + 0.5 * h, xc + 0.5 * h * k2x, yc + 0.5 * h * k2y)
        k3y := dy(tc + 0.5 * h, xc + 0.5 * h * k2x, yc + 0.5 * h * k2y)
        k4x := dx(tc + h, xc + h * k3x, yc + h * k3y)
        k4y := dy(tc + h, xc + h * k3x, yc + h * k3y)
        xc  += (h / 6) * (k1x + 2 * k2x + 2 * k3x + k4x)
        yc  += (h / 6) * (k1y + 2 * k2y + 2 * k3y + k4y)
        tc  += h
        s   += 1
    }
    list(calc_snap(xc, 1e-9), calc_snap(yc, 1e-9))
}

# @desc Computes `ode_coupled3(var_t: real, var_x: real, var_y: real, var_z: real, dx: real, dy: real, dz: real, t0: real, x0: real, y0: real, z0: real, t1: real, steps: real = 100)` in module [calculus] (Unit-Preserving Noise Snapping & Core Lazy Calculus Constructs).
# @param var_t: real — Independent time variable identifier (e.g. `t`)
# @param var_x: real — Symbolic variable identifier (e.g. `x`)
# @param var_y: real — State variable identifier (e.g. `y`)
# @param var_z: real — Input parameter `var_z` for `ode_coupled3`
# @param dx: real — Input parameter `dx` for `ode_coupled3`
# @param dy: real — Input parameter `dy` for `ode_coupled3`
# @param dz: real — Input parameter `dz` for `ode_coupled3`
# @param t0: real — Initial starting time t₀
# @param x0: real — Evaluation point or initial root/state estimate
# @param y0: real — Initial Y coordinate or initial state value
# @param z0: real — Input parameter `z0` for `ode_coupled3`
# @param t1: real — Target final time t₁
# @param steps: real — Number of numerical integration or iteration steps (default 100)
# @return vec — Result returned by `ode_coupled3(var_t: real, var_x: real, var_y: real, var_z: real, dx: real, dy: real, dz: real, t0: real, x0: real, y0: real, z0: real, t1: real, steps: real = 100)` in [calculus]
ode_coupled3(var_t, var_x, var_y, var_z, dx, dy, dz, t0, x0, y0, z0, t1, steps = 100) -> vec = {
    n := @floor(steps)
    if (n < 1) { n = 1 }
    if (n > 4096) { n = 4096 }
    h  := (t1 - t0) / n
    tc := t0
    xc := x0
    yc := y0
    zc := z0
    s  := 0
    (s < n) ?? {
        k1x := dx(tc, xc, yc, zc)
        k1y := dy(tc, xc, yc, zc)
        k1z := dz(tc, xc, yc, zc)
        k2x := dx(tc + 0.5 * h, xc + 0.5 * h * k1x, yc + 0.5 * h * k1y, zc + 0.5 * h * k1z)
        k2y := dy(tc + 0.5 * h, xc + 0.5 * h * k1x, yc + 0.5 * h * k1y, zc + 0.5 * h * k1z)
        k2z := dz(tc + 0.5 * h, xc + 0.5 * h * k1x, yc + 0.5 * h * k1y, zc + 0.5 * h * k1z)
        k3x := dx(tc + 0.5 * h, xc + 0.5 * h * k2x, yc + 0.5 * h * k2y, zc + 0.5 * h * k2z)
        k3y := dy(tc + 0.5 * h, xc + 0.5 * h * k2x, yc + 0.5 * h * k2y, zc + 0.5 * h * k2z)
        k3z := dz(tc + 0.5 * h, xc + 0.5 * h * k2x, yc + 0.5 * h * k2y, zc + 0.5 * h * k2z)
        k4x := dx(tc + h, xc + h * k3x, yc + h * k3y, zc + h * k3z)
        k4y := dy(tc + h, xc + h * k3x, yc + h * k3y, zc + h * k3z)
        k4z := dz(tc + h, xc + h * k3x, yc + h * k3y, zc + h * k3z)
        xc  += (h / 6) * (k1x + 2 * k2x + 2 * k3x + k4x)
        yc  += (h / 6) * (k1y + 2 * k2y + 2 * k3y + k4y)
        zc  += (h / 6) * (k1z + 2 * k2z + 2 * k3z + k4z)
        tc  += h
        s   += 1
    }
    list(calc_snap(xc, 1e-9), calc_snap(yc, 1e-9), calc_snap(zc, 1e-9))
}

# 1. Symbolic Polynomial Evaluation, Differentiation & Integration
# @desc Evaluates a polynomial with ascending coefficient vector `c = [c₀, c₁, c₂, ...]` at point `x` (`c₀ + c₁x + c₂x² + ...`) via Horner's method. Formula: poly_eval(c, x)
# @param c: vec — Coefficient vector `[c0, c1, c2, ...]` in ascending powers of x
# @param x: real — Point at which to evaluate the polynomial
# @return real — Polynomial value P(x)
poly_eval(c:vec, x) = {
    n   := c.len()
    acc := 0
    k   := n - 1
    (k >= 0) ?? {
        acc = acc * x + c[k]
        k  -= 1
    }
    acc
}

# Symbolic derivative coefficient vector: d/dx (c0 + c1*x + c2*x^2 + ...) = [c1, 2*c2, 3*c3, ...]
# @desc Computes the derivative coefficient vector `[c₁, 2c₂, 3c₃, ...]` of polynomial `c = [c₀, c₁, c₂, ...]`. Formula: poly_diff(c)
# @param c: vec — Ascending polynomial coefficient vector `[c0, c1, c2, ...]`
# @return vec — Coefficient vector of the derivative polynomial P'(x)
poly_diff(c:vec) -> vec = {
    n   := c.len()
    out := vec<real>()
    if (n <= 1) {
        0 into out
    } else {
        k := 1
        (k < n) ?? {
            (k * c[k]) into out
            k += 1
        }
    }
    out
}

# @desc Computes `poly_diff_at(c: vec, x0: real)` in module [calculus] (Symbolic Polynomial Evaluation, Differentiation & Integration).
# @param c: vec — Polynomial coefficient vector `[c0, c1, c2, ...]` or circle struct
# @param x0: real — Evaluation point or initial root/state estimate
# @return any — Result returned by `poly_diff_at(c: vec, x0: real)` in [calculus]
poly_diff_at(c:vec, x0) = {
    dc := poly_diff(c)
    poly_eval(dc, x0)
}

# @desc Computes `poly_diff2_at(c: vec, x0: real)` in module [calculus] (Symbolic Polynomial Evaluation, Differentiation & Integration).
# @param c: vec — Polynomial coefficient vector `[c0, c1, c2, ...]` or circle struct
# @param x0: real — Evaluation point or initial root/state estimate
# @return any — Result returned by `poly_diff2_at(c: vec, x0: real)` in [calculus]
poly_diff2_at(c:vec, x0) = {
    d2c := poly_diff(poly_diff(c))
    poly_eval(d2c, x0)
}

# @desc Computes the exact definite integral ∫[a..b] P(x) dx of polynomial `c` over [a, b] via the Fundamental Theorem of Calculus. Formula: poly_def_integ(c, a, b)
# @param c: vec — Ascending polynomial coefficient vector `[c0, c1, c2, ...]`
# @param a: real — Lower integration limit
# @param b: real — Upper integration limit
# @return real — Exact definite integral ∫[a..b] P(x) dx
poly_def_integ(c:vec, a, b) = {
    ic := poly_integ(c, 0)
    poly_eval(ic, b) - poly_eval(ic, a)
}

# 2. Tangent Lines, Normal Lines, Curvature & Critical Points
# @desc Calculates the slope m = P'(x₀) of the line tangent to polynomial `c` at `x = x0`. Formula: tangent_slope(c, x0) = poly_diff_at(c, x0)
# @param c: vec — Ascending polynomial coefficient vector
# @param x0: real — Point of tangency x₀
# @return real — Tangent slope P'(x₀)
tangent_slope(c:vec, x0) = poly_diff_at(c, x0)
# @desc Calculates the slope m_⊥ = −1 / P'(x₀) of the line normal (perpendicular) to polynomial `c` at `x = x0`. Formula: normal_slope(c, x0) = -1 / poly_diff_at(c, x0)
# @param c: vec — Ascending polynomial coefficient vector
# @param x0: real — Point x₀ on the curve
# @return real — Normal line slope −1 / P'(x₀)
normal_slope(c:vec, x0)  = -1 / poly_diff_at(c, x0)

# @desc Evaluates the y-coordinate y = P(x₀) + P'(x₀)·(x − x₀) on the tangent line to polynomial `c` at `x0`. Formula: tangent_y(c, x0, x)
# @param c: vec — Ascending polynomial coefficient vector
# @param x0: real — Point of tangency x₀
# @param x: real — x-coordinate at which to evaluate the tangent line
# @return real — y-value on the tangent line at `x`
tangent_y(c:vec, x0, x) =
    poly_eval(c, x0) + poly_diff_at(c, x0) * (x - x0)

# @desc Evaluates the y-coordinate y = P(x₀) − (1 / P'(x₀))·(x − x₀) on the normal line to polynomial `c` at `x0`. Formula: normal_y(c, x0, x)
# @param c: vec — Ascending polynomial coefficient vector
# @param x0: real — Point x₀ on the curve
# @param x: real — x-coordinate at which to evaluate the normal line
# @return real — y-value on the normal line at `x`
normal_y(c:vec, x0, x) =
    poly_eval(c, x0) + (-1 / poly_diff_at(c, x0)) * (x - x0)

# @desc Calculates the signed curvature κ = |P''(x₀)| / (1 + [P'(x₀)]²)^(3/2) of polynomial `c` at `x0`. Formula: poly_curvature(c, x0)
# @param c: vec — Ascending polynomial coefficient vector
# @param x0: real — Point x₀ at which curvature is evaluated
# @return real — Curvature κ ≥ 0 at x₀
poly_curvature(c:vec, x0) = {
    dy  := poly_diff_at(c, x0)
    d2y := poly_diff2_at(c, x0)
    @abs(d2y) / ((1 + dy^2) ^ 1.5)
}

# @desc Finds the x-coordinate of the vertex (stationary point) x = −b / (2a) of a quadratic parabola y = ax² + bx + c. Formula: quad_critical_x(a, b, c_term = 0) = -b / (2 · a)
# @param a: real — Quadratic x² coefficient (a ≠ 0)
# @param b: real — Linear x coefficient
# @param c_term: real — Constant term c (optional, default 0)
# @return real — Abscissa x = −b / (2a) of the parabola's vertex
quad_critical_x(a, b, c_term = 0) = -b / (2a) + 0 * c_term
# @desc Finds the extremum (minimum or maximum vertex y-value) y = c − b² / (4a) of a quadratic parabola y = ax² + bx + c. Formula: quad_extremum_y(a, b, c_term) = c_term - (b^2) / (4 · a)
# @param a: real — Quadratic x² coefficient (a ≠ 0)
# @param b: real — Linear x coefficient
# @param c_term: real — Constant term c
# @return real — Vertex y-value c − b²/(4a) (minimum if a > 0, maximum if a < 0)
quad_extremum_y(a, b, c_term)     = c_term - (b^2) / (4a)

# @desc Finds a root of polynomial `c` starting from `x_init` via Newton-Raphson iteration. Formula: poly_newton_root(c, x_init)
# @param c: vec — Ascending polynomial coefficient vector
# @param x_init: real — Initial root guess
# @return real — Converged root x satisfying P(x) ≈ 0
poly_newton_root(c:vec, x_init) = {
    xr   := x_init
    iter := 0
    (iter < 35) ?? {
        fx  := poly_eval(c, xr)
        dfx := poly_diff_at(c, xr)
        if (@abs(fx) <= (10 ^ -12)) { break }
        xr   -= fx / dfx
        iter += 1
    }
    xr
}

# 3. Integral Calculus Applications (Mean Value, Arc Length, Solids of Revolution)
# @desc Calculates the mean value (1 / (b − a)) ∫[a..b] P(x) dx of polynomial `c` over the interval [a, b]. Formula: poly_avg_val(c, a, b) = poly_def_integ(c, a, b) / (b - a)
# @param c: vec — Ascending polynomial coefficient vector
# @param a: real — Interval start a
# @param b: real — Interval end b (b ≠ a)
# @return real — Average value of the polynomial over [a, b]
poly_avg_val(c:vec, a, b) =
    poly_def_integ(c, a, b) / (b - a)

# @desc Calculates the curve arc length ∫[a..b] √(1 + [P'(x)]²) dx of polynomial `c` over [a, b]. Formula: poly_arc_length(c, a, b)
# @param c: vec — Ascending polynomial coefficient vector
# @param a: real — Start x-coordinate a
# @param b: real — End x-coordinate b
# @return real — Arc length of y = P(x) from x = a to x = b
poly_arc_length(c:vec, a, b) =
    integrate(t_var, √(1 + (poly_diff_at(c, t_var) ^ 2)), a, b)

# @desc Calculates the volume of the solid of revolution V = π ∫[a..b] [P(x)]² dx generated by revolving polynomial `c` around the X-axis (Disk Method). Formula: poly_vol_disk(c, a, b)
# @param c: vec — Ascending polynomial coefficient vector
# @param a: real — Lower x bound a
# @param b: real — Upper x bound b
# @return real — Volume of revolution around the X-axis
poly_vol_disk(c:vec, a, b) =
    π * integrate(t_var, poly_eval(c, t_var) ^ 2, a, b)

# @desc Calculates the volume of the solid of revolution V = 2π ∫[a..b] x·|P(x)| dx generated by revolving polynomial `c` around the Y-axis (Cylindrical Shell Method). Formula: poly_vol_shell(c, a, b)
# @param c: vec — Ascending polynomial coefficient vector
# @param a: real — Lower x bound a
# @param b: real — Upper x bound b
# @return real — Volume of revolution around the Y-axis
poly_vol_shell(c:vec, a, b) =
    2π * integrate(t_var, t_var * @abs(poly_eval(c, t_var)), a, b)

# 4. Numerical Quadrature on Tabulated Data Vectors (`trapz_vec`, `simpson_vec`)
# @desc Approximates the definite integral of sampled y-values `y` with uniform grid spacing `dx` using the composite trapezoidal rule. Formula: trapz_vec(y, dx)
# @param y: vec — Vector of sampled function values `[y0, y1, ..., yn]`
# @param dx: real — Uniform horizontal spacing Δx between samples
# @return real — Trapezoidal integral approximation
trapz_vec(y:vec, dx) = {
    n   := y.len()
    acc := 0.5 * (y[0] + y[n - 1])
    k   := 1
    (k < n - 1) ?? {
        acc += y[k]
        k   += 1
    }
    acc * dx
}

# @desc Approximates the definite integral of sampled y-values `y` with uniform grid spacing `dx` using composite Simpson's rule. Formula: simpson_vec(y, dx)
# @param y: vec — Vector of sampled function values `[y0, y1, ..., yn]`
# @param dx: real — Uniform horizontal spacing Δx between samples
# @return real — Simpson's rule integral approximation
simpson_vec(y:vec, dx) = {
    n   := y.len()
    acc := y[0] + y[n - 1]
    k   := 1
    (k < n - 1) ?? {
        w   := (k % 2 == 1) ? 4 : 2
        acc += w * y[k]
        k   += 1
    }
    (dx / 3) * acc
}

# 5. Maclaurin / Taylor Series Partial Sums (`taylor_exp`, `taylor_sin`, `taylor_cos`)
# @desc Maclaurin partial sum of e^x. Define: taylor_exp(x, n_terms) = sigma(k_idx, (x^k_idx) / (k_idx!), 0, n_terms - 1). Default n terms = 12
# @param x: real — point of evaluation
# @param n_terms: real — number of series terms (default 10)
# @return real — The partial-sum approximation of e^x at that point
taylor_exp(x, n_terms = 12) =
    sigma(k_idx, (x ^ k_idx) / (k_idx!), 0, n_terms - 1)

# @desc Maclaurin partial sum of sin(x). Define: taylor_sin(x, n_terms) = sigma(k_idx, ((-1)^k_idx)·(x^(2k_idx + 1)) / ((2k_idx + 1)!), 0, n_terms - 1). Default n terms = 10
# @param x: real — point of evaluation (radians)
# @param n_terms: real — number of series terms (default 10)
# @return real — The partial-sum approximation of sin(x) at that point
taylor_sin(x, n_terms = 10) =
    sigma(k_idx, ((-1) ^ k_idx) * (x ^ (2k_idx + 1)) / ((2k_idx + 1)!), 0, n_terms - 1)

# @desc Maclaurin partial sum of cos(x). Define: taylor_cos(x, n_terms) = sigma(k_idx, ((-1)^k_idx)·(x^(2k_idx)) / ((2k_idx)!), 0, n_terms - 1). Default n terms = 10
# @param x: real — point of evaluation (radians)
# @param n_terms: real — number of series terms (default 10)
# @return real — The partial-sum approximation of cos(x) at that point
taylor_cos(x, n_terms = 10) =
    sigma(k_idx, ((-1) ^ k_idx) * (x ^ (2k_idx)) / ((2k_idx)!), 0, n_terms - 1)

# 6. Multivariate Calculus: Partial Derivatives, Gradients, Laplacian, Hessian & Gradient Descent
# @desc Computes `pdiff_x(f: fn, x0: real, y0: real)` in module [calculus] (Multivariate Calculus: Partial Derivatives, Gradients, Laplacian, Hessian & Gradient Descent).
# @param f: fn — Callable function or lambda `x => ...`
# @param x0: real — Evaluation point or initial root/state estimate
# @param y0: real — Initial Y coordinate or initial state value
# @return any — Result returned by `pdiff_x(f: fn, x0: real, y0: real)` in [calculus]
pdiff_x(f:fn, x0, y0) = {
    h := 1e-5 * (1 + @abs(x0))
    (-f(x0 + 2h, y0) + 8 * f(x0 + h, y0) - 8 * f(x0 - h, y0) + f(x0 - 2h, y0)) / (12h)
}

# @desc Computes `pdiff_y(f: fn, x0: real, y0: real)` in module [calculus] (Multivariate Calculus: Partial Derivatives, Gradients, Laplacian, Hessian & Gradient Descent).
# @param f: fn — Callable function or lambda `x => ...`
# @param x0: real — Evaluation point or initial root/state estimate
# @param y0: real — Initial Y coordinate or initial state value
# @return any — Result returned by `pdiff_y(f: fn, x0: real, y0: real)` in [calculus]
pdiff_y(f:fn, x0, y0) = {
    h := 1e-5 * (1 + @abs(y0))
    (-f(x0, y0 + 2h) + 8 * f(x0, y0 + h) - 8 * f(x0, y0 - h) + f(x0, y0 - 2h)) / (12h)
}

# @desc Computes `grad2(f: fn, x0: real, y0: real)` in module [calculus] (Multivariate Calculus: Partial Derivatives, Gradients, Laplacian, Hessian & Gradient Descent). Formula: grad2(f:fn, x0, y0) = vec2(pdiff_x(f, x0, y0), pdiff_y(f, x0, y0))
# @param f: fn — Callable function or lambda `x => ...`
# @param x0: real — Evaluation point or initial root/state estimate
# @param y0: real — Initial Y coordinate or initial state value
# @return vec2 — Result returned by `grad2(f: fn, x0: real, y0: real)` in [calculus]
grad2(f:fn, x0, y0) -> vec2 = vec2(pdiff_x(f, x0, y0), pdiff_y(f, x0, y0))

# @desc Computes `grad3(f: fn, x0: real, y0: real, z0: real)` in module [calculus] (Multivariate Calculus: Partial Derivatives, Gradients, Laplacian, Hessian & Gradient Descent).
# @param f: fn — Callable function or lambda `x => ...`
# @param x0: real — Evaluation point or initial root/state estimate
# @param y0: real — Initial Y coordinate or initial state value
# @param z0: real — Input parameter `z0` for `grad3`
# @return vec3 — Result returned by `grad3(f: fn, x0: real, y0: real, z0: real)` in [calculus]
grad3(f:fn, x0, y0, z0) -> vec3 = {
    hx := 1e-5 * (1 + @abs(x0))
    hy := 1e-5 * (1 + @abs(y0))
    hz := 1e-5 * (1 + @abs(z0))
    gx := (-f(x0 + 2hx, y0, z0) + 8 * f(x0 + hx, y0, z0) - 8 * f(x0 - hx, y0, z0) + f(x0 - 2hx, y0, z0)) / (12hx)
    gy := (-f(x0, y0 + 2hy, z0) + 8 * f(x0, y0 + hy, z0) - 8 * f(x0, y0 - hy, z0) + f(x0, y0 - 2hy, z0)) / (12hy)
    gz := (-f(x0, y0, z0 + 2hz) + 8 * f(x0, y0, z0 + hz) - 8 * f(x0, y0, z0 - hz) + f(x0, y0, z0 - 2hz)) / (12hz)
    vec3(gx, gy, gz)
}

grad3(f:fn, p:vec3) -> vec3 = {
    hx := 1e-5 * (1 + @abs(p.x))
    hy := 1e-5 * (1 + @abs(p.y))
    hz := 1e-5 * (1 + @abs(p.z))
    gx := (-f(vec3(p.x + 2hx, p.y, p.z)) + 8 * f(vec3(p.x + hx, p.y, p.z)) - 8 * f(vec3(p.x - hx, p.y, p.z)) + f(vec3(p.x - 2hx, p.y, p.z))) / (12hx)
    gy := (-f(vec3(p.x, p.y + 2hy, p.z)) + 8 * f(vec3(p.x, p.y + hy, p.z)) - 8 * f(vec3(p.x, p.y - hy, p.z)) + f(vec3(p.x, p.y - 2hy, p.z))) / (12hy)
    gz := (-f(vec3(p.x, p.y, p.z + 2hz)) + 8 * f(vec3(p.x, p.y, p.z + hz)) - 8 * f(vec3(p.x, p.y, p.z - hz)) + f(vec3(p.x, p.y, p.z - 2hz))) / (12hz)
    vec3(gx, gy, gz)
}

# @desc Computes `laplacian2(f: fn, x0: real, y0: real)` in module [calculus] (Multivariate Calculus: Partial Derivatives, Gradients, Laplacian, Hessian & Gradient Descent).
# @param f: fn — Callable function or lambda `x => ...`
# @param x0: real — Evaluation point or initial root/state estimate
# @param y0: real — Initial Y coordinate or initial state value
# @return any — Result returned by `laplacian2(f: fn, x0: real, y0: real)` in [calculus]
laplacian2(f:fn, x0, y0) = {
    hx  := 1e-4 * (1 + @abs(x0))
    hy  := 1e-4 * (1 + @abs(y0))
    f0  := f(x0, y0)
    dxx := (-f(x0 + 2hx, y0) + 16 * f(x0 + hx, y0) - 30 * f0 + 16 * f(x0 - hx, y0) - f(x0 - 2hx, y0)) / (12 * (hx^2))
    dyy := (-f(x0, y0 + 2hy) + 16 * f(x0, y0 + hy) - 30 * f0 + 16 * f(x0, y0 - hy) - f(x0, y0 - 2hy)) / (12 * (hy^2))
    dxx + dyy
}

# @desc Computes `hessian2(f: fn, x0: real, y0: real)` in module [calculus] (Multivariate Calculus: Partial Derivatives, Gradients, Laplacian, Hessian & Gradient Descent).
# @param f: fn — Callable function or lambda `x => ...`
# @param x0: real — Evaluation point or initial root/state estimate
# @param y0: real — Initial Y coordinate or initial state value
# @return mat2 — Result returned by `hessian2(f: fn, x0: real, y0: real)` in [calculus]
hessian2(f:fn, x0, y0) -> mat2 = {
    hx  := 1e-4 * (1 + @abs(x0))
    hy  := 1e-4 * (1 + @abs(y0))
    f0  := f(x0, y0)
    dxx := (-f(x0 + 2hx, y0) + 16 * f(x0 + hx, y0) - 30 * f0 + 16 * f(x0 - hx, y0) - f(x0 - 2hx, y0)) / (12 * (hx^2))
    dyy := (-f(x0, y0 + 2hy) + 16 * f(x0, y0 + hy) - 30 * f0 + 16 * f(x0, y0 - hy) - f(x0, y0 - 2hy)) / (12 * (hy^2))
    dxy := (f(x0 + hx, y0 + hy) - f(x0 + hx, y0 - hy) - f(x0 - hx, y0 + hy) + f(x0 - hx, y0 - hy)) / (4 * hx * hy)
    mat2(dxx, dxy, dxy, dyy)
}

# @desc Computes `dir_deriv2(f: fn, x0: real, y0: real, u: vec2)` in module [calculus] (Multivariate Calculus: Partial Derivatives, Gradients, Laplacian, Hessian & Gradient Descent).
# @param f: fn — Callable function or lambda `x => ...`
# @param x0: real — Evaluation point or initial root/state estimate
# @param y0: real — Initial Y coordinate or initial state value
# @param u: vec2 — Input parameter `u` for `dir_deriv2`
# @return any — Result returned by `dir_deriv2(f: fn, x0: real, y0: real, u: vec2)` in [calculus]
dir_deriv2(f:fn, x0, y0, u:vec2) = {
    g := grad2(f, x0, y0)
    dot(g, u) / vec2_mag(u)
}

# @desc Computes `grad_descent_1d(f: fn, x0: real, lr: real = 0.1, steps: real = 100)` in module [calculus] (Multivariate Calculus: Partial Derivatives, Gradients, Laplacian, Hessian & Gradient Descent).
# @param f: fn — Callable function or lambda `x => ...`
# @param x0: real — Evaluation point or initial root/state estimate
# @param lr: real — Input parameter `lr` for `grad_descent_1d` (default 0.1)
# @param steps: real — Number of numerical integration or iteration steps (default 100)
# @return any — Result returned by `grad_descent_1d(f: fn, x0: real, lr: real = 0.1, steps: real = 100)` in [calculus]
grad_descent_1d(f:fn, x0, lr = 0.1, steps = 100) = {
    x := x0
    k := 0
    (k < steps) ?? {
        h  := 1e-5 * (1 + @abs(x))
        dx := (f(x + h) - f(x - h)) / (2h)
        x  -= lr * dx
        k  += 1
    }
    x
}

# @desc Computes `grad_descent_2d(f: fn, p0: vec2, lr: real = 0.1, steps: real = 100)` in module [calculus] (Multivariate Calculus: Partial Derivatives, Gradients, Laplacian, Hessian & Gradient Descent).
# @param f: fn — Callable function or lambda `x => ...`
# @param p0: vec2 — Input parameter `p0` for `grad_descent_2d`
# @param lr: real — Input parameter `lr` for `grad_descent_2d` (default 0.1)
# @param steps: real — Number of numerical integration or iteration steps (default 100)
# @return vec2 — Result returned by `grad_descent_2d(f: fn, p0: vec2, lr: real = 0.1, steps: real = 100)` in [calculus]
grad_descent_2d(f:fn, p0:vec2, lr = 0.1, steps = 100) -> vec2 = {
    p := p0
    k := 0
    (k < steps) ?? {
        g := grad2(f, p.x, p.y)
        p  = p - lr * g
        k += 1
    }
    p
}

# 7. First-Class Closure & Lazy System ODE Solvers (`ode_rk4_sys`, `ode_rk4_sys_traj`)
# @desc Computes `ode_rk4_sys(f: fn, t0: real, y0: T, t1: real, steps: real = 100)` in module [calculus] (First-Class Closure & Lazy System ODE Solvers (`ode_rk4_sys`, `ode_rk4_sys_traj`)).
# @param f: fn — Callable function or lambda `x => ...`
# @param t0: real — Initial starting time t₀
# @param y0: T — Initial Y coordinate or initial state value
# @param t1: real — Target final time t₁
# @param steps: real — Number of numerical integration or iteration steps (default 100)
# @return vec — Result returned by `ode_rk4_sys(f: fn, t0: real, y0: T, t1: real, steps: real = 100)` in [calculus]
ode_rk4_sys(f:fn, t0, y0:T, t1, steps = 100) -> vec = {
    if (steps <= 0) { error("ode_rk4_sys() steps must be positive") }
    h    := (t1 - t0) / steps
    t    := t0
    y    := [x for x in y0]
    n    := y.len()
    step := 0
    (step < steps) ?? {
        k1 := [x for x in f(t, y)]
        if (k1.len() != n) { error("ode_rk4_sys() RHS dimension mismatch") }
        y2 := [y[i] + 0.5 * h * k1[i] for i in 0..<n]
        k2 := [x for x in f(t + 0.5 * h, y2)]
        y3 := [y[i] + 0.5 * h * k2[i] for i in 0..<n]
        k3 := [x for x in f(t + 0.5 * h, y3)]
        y4 := [y[i] + h * k3[i] for i in 0..<n]
        k4 := [x for x in f(t + h, y4)]
        y   = [y[i] + (h / 6) * (k1[i] + 2 * k2[i] + 2 * k3[i] + k4[i]) for i in 0..<n]
        t  += h
        step += 1
    }
    [calc_snap(x, 1e-9) for x in y]
}

ode_rk4_sys(var_t, var_y, rhs_vec, t0, y0:T, t1, steps = 100) -> vec =
    ode_rk4_sys(rhs_vec, t0, y0, t1, steps)

# @desc Computes `ode_rk4_sys_traj(var_t: real, var_y: real, rhs_vec: real, t0: real, y0: T, t1: real, steps: real = 20)` in module [calculus] (First-Class Closure & Lazy System ODE Solvers (`ode_rk4_sys`, `ode_rk4_sys_traj`)).
# @param var_t: real — Independent time variable identifier (e.g. `t`)
# @param var_y: real — State variable identifier (e.g. `y`)
# @param rhs_vec: real — Input parameter `rhs_vec` for `ode_rk4_sys_traj`
# @param t0: real — Initial starting time t₀
# @param y0: T — Initial Y coordinate or initial state value
# @param t1: real — Target final time t₁
# @param steps: real — Number of numerical integration or iteration steps (default 20)
# @return mat — Result returned by `ode_rk4_sys_traj(var_t: real, var_y: real, rhs_vec: real, t0: real, y0: T, t1: real, steps: real = 20)` in [calculus]
ode_rk4_sys_traj(var_t, var_y, rhs_vec, t0, y0:T, t1, steps = 20) -> mat = {
    st := @floor(steps)
    if (st < 1) { st = 1 }
    h   := (t1 - t0) / st
    tc  := t0
    y   := [x for x in y0]
    n   := y.len()
    out := mat_zeros(st + 1, n)
    d   := 0
    (d < n) ?? {
        out[0, d] = calc_snap(y[d], 1e-9)
        d += 1
    }
    s := 0
    (s < st) ?? {
        k1 := [x for x in rhs_vec(tc, y)]
        y2 := [y[i] + 0.5 * h * k1[i] for i in 0..<n]
        k2 := [x for x in rhs_vec(tc + 0.5 * h, y2)]
        y3 := [y[i] + 0.5 * h * k2[i] for i in 0..<n]
        k3 := [x for x in rhs_vec(tc + 0.5 * h, y3)]
        y4 := [y[i] + h * k3[i] for i in 0..<n]
        k4 := [x for x in rhs_vec(tc + h, y4)]
        y   = [y[i] + (h / 6) * (k1[i] + 2 * k2[i] + 2 * k3[i] + k4[i]) for i in 0..<n]
        tc += h
        s  += 1
        d   = 0
        (d < n) ?? {
            out[s, d] = calc_snap(y[d], 1e-9)
            d += 1
        }
    }
    out
}

# 8. Pure MEP Symbolic Taylor / Maclaurin Polynomial Expansion (`sym_taylor`)
# @desc Constructs the symbolic Taylor series polynomial of `expr` around `var_x = x0` up to degree `order`. Formula: sym_taylor(var_x, expr, x0, order)
# @param var_x: ident — Expansion variable symbol (e.g. `x`)
# @param expr: ast — Symbolic function f(x) to expand
# @param x0: real — Center point x₀ of the Taylor expansion
# @param order: int — Maximum polynomial degree n
# @return str — Symbolic Taylor polynomial expansion string
sym_taylor(var_x, expr, x0, order) -> str = {
    vname := sym_diff(var_x, expr, -1)
    d_str := sym_diff(var_x, expr, 0)
    base  := (@abs(x0) <= 1e-12) ? vname : ("(" + vname + " - " + (x0_) + ")")
    poly  := "0"
    fact  := 1
    (k in 0...order) {
        if (k > 0) { fact *= k }
        fk := sym_eval(d_str, vname, x0)
        ck := calc_snap(fk / fact, 1e-12)
        if (@abs(ck) > 1e-12) {
            term := (k == 0) ? (ck_) : ((k == 1) ? ((ck_) + " * " + base) : ((ck_) + " * " + base + " ^ " + (k_)))
            poly = poly + " + " + term
        }
        if (k < order) {
            d_str = sym_diff(vname, d_str, 1)
        }
    }
    sym_simplify(poly)
}
