# =============================================================================
# Library/algebra.math — Matrices, Linear Systems, Quadratics & Polynomials
# =============================================================================

[algebra]
<[arith]
<[trig]
<[complex_ext]
<[geom_ext]
<[vec]
<[mat]

# 1. 2x2 Matrix Struct (`$mat2`: row-major [a, b; c, d])
$mat2(a, b, c, d)

(m1:mat2) "+"  (m2:mat2) :<50 -> mat2 =
    mat2(m1.a + m2.a, m1.b + m2.b, m1.c + m2.c, m1.d + m2.d)

(m1:mat2) "-"  (m2:mat2) :<50 -> mat2 =
    mat2(m1.a - m2.a, m1.b - m2.b, m1.c - m2.c, m1.d - m2.d)

(m1:mat2) into (m2:mat2) :>55 -> mat2 =
    mat2(m1.a + m2.a, m1.b + m2.b, m1.c + m2.c, m1.d + m2.d)

(m1:mat2) "*"  (m2:mat2) :<60 -> mat2 =
    mat2(m1.a * m2.a + m1.b * m2.c, m1.a * m2.b + m1.b * m2.d,
         m1.c * m2.a + m1.d * m2.c, m1.c * m2.b + m1.d * m2.d)

(m:mat2) "*" (v:vec2) :<60 -> vec2 =
    vec2(m.a * v.x + m.b * v.y, m.c * v.x + m.d * v.y)

"-" (m:mat2)             :80  -> mat2 =
    mat2(-m.a, -m.b, -m.c, -m.d)

(s)      "*" (m:mat2) :<60 -> mat2 =
    mat2(s * m.a, s * m.b, s * m.c, s * m.d)

(m:mat2) "*" (s)      :<60 -> mat2 =
    mat2(m.a * s, m.b * s, m.c * s, m.d * s)

(m:mat2) "/" (s)      :<60 -> mat2 =
    mat2(m.a / s, m.b / s, m.c / s, m.d / s)

(m1:mat2) "==" (m2:mat2) :<30 =
    (m1.a == m2.a) && (m1.b == m2.b) && (m1.c == m2.c) && (m1.d == m2.d)

(m1:mat2) "!=" (m2:mat2) :<30 =
    (m1.a != m2.a) || (m1.b != m2.b) || (m1.c != m2.c) || (m1.d != m2.d)

(m1:mat2) "~"  (m2:mat2) :<30 =
    (m1.a ~ m2.a) && (m1.b ~ m2.b) && (m1.c ~ m2.c) && (m1.d ~ m2.d)

# @desc Computes the scalar determinant det(M) of a square n×n matrix (via LU decomposition) or a 2×2 `$mat2` struct. Formula: det(m)
# @param m: mat | mat2 — Square n×n matrix or `$mat2` struct
# @return real — Scalar determinant det(m)
det(m:mat2)              = m.a * m.d - m.b * m.c
# @desc Computes the matrix trace tr(M) = ∑ M[i, i], the sum of elements along the main diagonal. Formula: trace(m)
# @param m: mat | mat2 — Square matrix or `$mat2` struct
# @return real — Sum of diagonal elements tr(m)
trace(m:mat2)            = m.a + m.d
# @desc Flips a matrix M over its main diagonal, turning an r×c matrix into a c×r matrix Mᵀ. Formula: transpose(m)
# @param m: mat | mat2 — Input r×c matrix or 2×2 `$mat2` struct
# @return mat | mat2 — Transposed c×r matrix Mᵀ
transpose(m:mat2) -> mat2 = mat2(m.a, m.c, m.b, m.d)

# @desc Computes the exact inverse of a 2×2 `$mat2(a, b, c, d)` struct: (1 / (ad − bc)) · mat2(d, −b, −c, a). Formula: inv_mat2(m)
# @param m: mat2 — Invertible 2×2 matrix struct `mat2(a, b, c, d)`
# @return mat2 — Inverse 2×2 matrix struct
inv_mat2(m:mat2) -> mat2 = {
    d := det(m)
    mat2(m.d / d, -m.b / d, -m.c / d, m.a / d)
}

# 2. 2x2 Linear Equation System Solver (Cramer's Rule)
# @desc Solves the 2×2 linear system a₁x + b₁y = c₁ and a₂x + b₂y = c₂ via Cramer's Rule, returning `vec2(x, y)`. Formula: solve_2x2(a1, b1, c1, a2, b2, c2)
# @param a1: real — Coefficient of x in equation 1
# @param b1: real — Coefficient of y in equation 1
# @param c1: real — Right-hand side constant of equation 1
# @param a2: real — Coefficient of x in equation 2
# @param b2: real — Coefficient of y in equation 2
# @param c2: real — Right-hand side constant of equation 2
# @return vec2 — Solution pair `vec2(x, y)`
solve_2x2(a1, b1, c1, a2, b2, c2) -> vec2 = {
    d  := a1 * b2 - b1 * a2
    dx := c1 * b2 - b1 * c2
    dy := a1 * c2 - c1 * a2
    vec2(dx / d, dy / d)
}

# 3. Quadratic Equation Solvers (`a*x^2 + b*x + c = 0`)
# @desc Calculates the quadratic discriminant Δ = b² − 4ac of a polynomial ax² + bx + c = 0 (Δ > 0: two distinct real roots; Δ = 0: repeated root; Δ < 0: complex conjugate roots). Formula: quad_disc(a, b, c) = b^2 - 4·a·c
# @param a: real — Coefficient of x²
# @param b: real — Coefficient of x
# @param c: real — Constant term
# @return real — Discriminant Δ = b² − 4ac
quad_disc(a, b, c) = b^2 - 4a * c

# @desc Computes the two real roots `vec2(r1, r2)` of a quadratic equation ax² + bx + c = 0 when Δ = b² − 4ac ≥ 0. Formula: quad_roots(a, b, c) = vec2((-b - √Δ)/(2a), (-b + √Δ)/(2a))
# @param a: real — Quadratic x² coefficient (a ≠ 0)
# @param b: real — Linear x coefficient
# @param c: real — Constant term
# @return vec2 — Pair of real roots `vec2(r1, r2)`
quad_roots(a, b, c) -> vec2 = {
    sd := √(b^2 - 4a * c)
    vec2((-b + sd) / (2a), (-b - sd) / (2a))
}

# @desc Computes the principal root of ax² + bx + c = 0 as a `$complex` number (handling both real roots when Δ ≥ 0 and complex roots when Δ < 0). Formula: quad_croot(a, b, c)
# @param a: real — Quadratic x² coefficient (a ≠ 0)
# @param b: real — Linear x coefficient
# @param c: real — Constant term
# @return complex — Principal root `complex(re, im)`
quad_croot(a, b, c) -> complex = {
    d := b^2 - 4a * c
    if (d >= 0) {
        complex((-b + √d) / (2a), 0)
    } else {
        complex(-b / (2a), √(-d) / (2a))
    }
}

# 4. Symbolic & Numerical Polynomial Algebra on `$vec`
#    Polynomial `P(x) = c_0 + c_1*x + c_2*x^2 + ... + c_n*x^n` stored as `[c_0, c_1, ..., c_n]`

# @desc Evaluates a polynomial with ascending coefficient vector `coeffs = [c₀, c₁, c₂, ...]` at `x` using O(n) Horner's scheme. Formula: poly_val(coeffs, x)
# @param coeffs: vec — Coefficient vector `[c0, c1, c2, ...]` in ascending powers of x
# @param x: real — Evaluation point x
# @return real — Polynomial value P(x)
poly_val(coeffs:vec, x) = {
    n   := coeffs.len()
    acc := 0
    if (n > 0) {
        (idx in (n - 1)...0) {
            acc = acc * x + coeffs[idx]
        }
    }
    acc
}

# @desc Computes the derivative coefficient vector `[c₁, 2c₂, 3c₃, ...]` of polynomial `coeffs = [c₀, c₁, c₂, ...]`. Formula: poly_deriv(coeffs)
# @param coeffs: vec — Ascending polynomial coefficient vector `[c0, c1, c2, ...]`
# @return vec — Coefficient vector of the derivative polynomial P'(x)
poly_deriv(coeffs:vec) -> vec = {
    n   := coeffs.len()
    out := vec<real>()
    if (n <= 1) {
        0 into out
    } else {
        (idx in 1..<n) {
            (idx * coeffs[idx]) into out
        }
    }
    out
}

# @desc Computes the indefinite integral coefficient vector `[c0, coeffs[0], coeffs[1]/2, ...]` of polynomial `coeffs` with integration constant `c0`. Formula: poly_integ(coeffs, c0 = 0)
# @param coeffs: vec — Ascending polynomial coefficient vector
# @param c0: real — Constant of integration (default 0)
# @return vec — Coefficient vector of the integrated polynomial ∫P(x) dx
poly_integ(coeffs:vec, c0 = 0) -> vec = {
    n   := coeffs.len()
    out := vec<real>()
    c0 into out
    if (n > 0) {
        (idx in 0..<n) {
            (coeffs[idx] / (idx + 1)) into out
        }
    }
    out
}

# @desc Adds two polynomials represented by ascending coefficient vectors `p` and `q`. Formula: poly_add(p, q)
# @param p: vec — First polynomial coefficient vector
# @param q: vec — Second polynomial coefficient vector
# @return vec — Coefficient vector of the sum polynomial P(x) + Q(x)
poly_add(p:vec, q:vec) -> vec = {
    np  := p.len()
    nq  := q.len()
    n   := max(np, nq)
    out := vec<real>()
    if (n > 0) {
        (idx in 0..<n) {
            vp := (idx < np) ? p[idx] : 0
            vq := (idx < nq) ? q[idx] : 0
            (vp + vq) into out
        }
    }
    out
}

# @desc Multiplies two polynomials `p` and `q` via discrete Cauchy convolution of their coefficient vectors. Formula: poly_mul(p, q)
# @param p: vec — First polynomial coefficient vector
# @param q: vec — Second polynomial coefficient vector
# @return vec — Coefficient vector of the product polynomial P(x) · Q(x)
poly_mul(p:vec, q:vec) -> vec = {
    np  := p.len()
    nq  := q.len()
    deg := np + nq - 1
    out := vec<real>(deg, 0)
    (ip in 0..<np) {
        (iq in 0..<nq) {
            k := ip + iq
            out[k] += p[ip] * q[iq]
        }
    }
    out
}

# @desc Finds a root of polynomial `coeffs` starting from `x0` using `steps` iterations of Newton-Raphson refinement. Formula: poly_newton(coeffs, x0, steps = 12)
# @param coeffs: vec — Ascending polynomial coefficient vector
# @param x0: real — Initial root guess x₀
# @param steps: int — Number of Newton-Raphson iterations (default 12)
# @return real — Refined polynomial root x
poly_newton(coeffs:vec, x0, steps = 12) = {
    dp := poly_deriv(coeffs)
    x  := x0
    (k in 0..<steps) {
        fx  := poly_val(coeffs, x)
        dfx := poly_val(dp, x)
        x  -= fx / dfx
    }
    x
}

# @desc Computes the multiplicative inverse M⁻¹ of a non-singular square n×n matrix or `$mat2` struct such that M · M⁻¹ = I. Formula: inv(m)
# @param m: mat | mat2 — Invertible square matrix (det(m) ≠ 0)
# @return mat | mat2 — Inverse matrix M⁻¹
mat2::inv(self) -> mat2  = inv_mat2(self)

poly_val(coeffs:mat, x)                 = poly_val(flatten(coeffs), x)
poly_deriv(coeffs:mat)           -> vec = poly_deriv(flatten(coeffs))
poly_integ(coeffs:mat, c0 = 0)   -> vec = poly_integ(flatten(coeffs), c0)
poly_add(p:mat, q:mat)           -> vec = poly_add(flatten(p), flatten(q))
poly_mul(p:mat, q:mat)           -> vec = poly_mul(flatten(p), flatten(q))
poly_newton(coeffs:mat, x0, steps = 12) = poly_newton(flatten(coeffs), x0, steps)
