# =============================================================================
# patches/user_trig.math — Reciprocal & Inverse Reciprocal Trig Extensions
# Offloaded from Ecalc's hardcoded BUILTIN_USER_TRIG_EXT into a remote patch.
# =============================================================================

[user_trig]
<[trig]

# Reciprocal circular trig alias (sec, csc, cot live in [trig])
cosec(x: real) = csc(x);

# Inverse reciprocal circular trig functions (radians)
asec(x: real)   = acos(1 / x);
acsc(x: real)   = asin(1 / x);
acosec(x: real) = asin(1 / x);
acot(x: real)   = atan(1 / x);

# N-th root helper alias
nthroot(x: real, n: real) = root(x, n);
