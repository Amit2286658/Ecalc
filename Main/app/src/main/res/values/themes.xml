<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Default startup theme is Light Theme so Android cold start always starts with Light Theme,
         while the in-app light/dark theme switcher remains completely independent at runtime. -->
    <style name="Theme.Ecalc" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">#F8F8F8</item>
        <item name="android:statusBarColor">#F8F8F8</item>
        <item name="android:navigationBarColor">#F3F3F3</item>
        <item name="android:windowSplashScreenBackground">#F8F8F8</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">150</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="colorPrimary">#F18977</item>
    </style>

    <style name="Theme.Ecalc.LaunchDark" parent="Theme.Ecalc">
        <item name="android:windowBackground">#F8F8F8</item>
        <item name="android:statusBarColor">#F8F8F8</item>
        <item name="android:navigationBarColor">#F3F3F3</item>
        <item name="android:windowSplashScreenBackground">#F8F8F8</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">150</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.Ecalc.LaunchLight" parent="Theme.Ecalc">
        <item name="android:windowBackground">#F8F8F8</item>
        <item name="android:statusBarColor">#F8F8F8</item>
        <item name="android:navigationBarColor">#F3F3F3</item>
        <item name="android:windowSplashScreenBackground">#F8F8F8</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">150</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
