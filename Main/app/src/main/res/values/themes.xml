<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Ecalc" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">#2D2D2D</item>
        <item name="android:statusBarColor">#2D2D2D</item>
        <item name="android:navigationBarColor">#333333</item>
        <item name="android:windowSplashScreenBackground">#2D2D2D</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="colorPrimary">#13959B</item>
    </style>

    <!-- Launch stages: the system draws the 12+ splash (and the pre-launch
         window preview) from the alias the launcher picks, so each alias's
         theme pins the splash to the APP's saved theme instead of the
         system's. -->
    <style name="Theme.Ecalc.LaunchDark">
        <item name="android:windowBackground">#2D2D2D</item>
        <item name="android:statusBarColor">#2D2D2D</item>
        <item name="android:navigationBarColor">#333333</item>
        <item name="android:windowSplashScreenBackground">#2D2D2D</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.Ecalc.LaunchLight">
        <item name="android:windowBackground">#F8F8F8</item>
        <item name="android:statusBarColor">#F8F8F8</item>
        <item name="android:navigationBarColor">#F3F3F3</item>
        <item name="android:windowSplashScreenBackground">#F8F8F8</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
