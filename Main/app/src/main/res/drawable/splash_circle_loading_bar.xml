<?xml version="1.0" encoding="utf-8"?>
<rotate xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromDegrees="0"
    android:pivotX="50%"
    android:pivotY="50%"
    android:toDegrees="360">
    <shape
        android:innerRadiusRatio="2.6"
        android:shape="ring"
        android:thickness="3.2dp"
        android:useLevel="false">
        <gradient
            android:centerColor="#80E58A7B"
            android:centerY="0.5"
            android:endColor="#FFE58A7B"
            android:startColor="#00E58A7B"
            android:type="sweep"
            android:useLevel="false" />
    </shape>
</rotate>
